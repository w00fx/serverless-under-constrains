{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rua.serverless-under-constraints.invalid/schemas/admission_rejection.schema.json",
  "title": "admission_rejection (BR-RUA-039)",
  "description": "The structured rejection of one admission attempt, written by the first failing read-only check (design §10.1). rejection_class is one of the AC-RUA-014 rejected input classes; failed_check_id names the admission step A1..A15. A rejected attempt carries no execution identity, because it creates no canonical manifest.",
  "type": "object",
  "properties": {
    "schema_version": { "const": 1 },
    "record_type": { "const": "admission_rejection" },
    "admission_attempt_id": { "$ref": "_defs.schema.json#/$defs/uuid4" },
    "execution_kind": { "enum": ["RUN", "TRANSPORT_PROBE", "VARIANT_VALIDATION"] },
    "rejection_class": {
      "enum": [
        "FINANCIAL_INPUT",
        "IDENTITY",
        "SOURCE_PROVENANCE",
        "ACCOUNT",
        "REGION",
        "SAFETY",
        "QUALIFICATION",
        "COORDINATION_CONFIGURATION"
      ]
    },
    "failed_check_id": { "type": "string", "pattern": "^A([1-9]|1[0-5])$" },
    "reasons": {
      "type": "array",
      "items": { "$ref": "_defs.schema.json#/$defs/structured_reason" },
      "minItems": 1
    },
    "rejected_at": { "$ref": "_defs.schema.json#/$defs/utc_millis" }
  },
  "required": [
    "schema_version",
    "record_type",
    "admission_attempt_id",
    "execution_kind",
    "rejection_class",
    "failed_check_id",
    "reasons",
    "rejected_at"
  ],
  "additionalProperties": false
}
