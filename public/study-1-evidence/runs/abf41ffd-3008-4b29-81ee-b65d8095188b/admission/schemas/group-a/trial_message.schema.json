{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rua.serverless-under-constraints.invalid/schemas/trial_message.schema.json",
  "title": "trial_message (BR-RUA-036)",
  "description": "The canonical published trial message; its serialized bytes are the exact SQS body. Exactly the BR-RUA-036 fields: one of run_id or variant_validation_id (a transport probe has no trial, D-06), the trial identity and frozen trial-manifest digest, and the business identifiers.",
  "type": "object",
  "properties": {
    "schema_version": { "const": 1 },
    "record_type": { "const": "trial_message" },
    "run_id": { "$ref": "_defs.schema.json#/$defs/uuid4" },
    "variant_validation_id": { "$ref": "_defs.schema.json#/$defs/uuid4" },
    "trial_id": { "$ref": "_defs.schema.json#/$defs/uuid4" },
    "trial_manifest_sha256": { "$ref": "_defs.schema.json#/$defs/sha256" },
    "payment_id": { "$ref": "_defs.schema.json#/$defs/nonempty_trimmed" },
    "refund_request_id": { "$ref": "_defs.schema.json#/$defs/nonempty_trimmed" }
  },
  "required": ["schema_version", "record_type", "trial_id", "trial_manifest_sha256", "payment_id", "refund_request_id"],
  "oneOf": [
    {
      "properties": { "run_id": { "$ref": "_defs.schema.json#/$defs/uuid4" } },
      "required": ["run_id"]
    },
    {
      "properties": { "variant_validation_id": { "$ref": "_defs.schema.json#/$defs/uuid4" } },
      "required": ["variant_validation_id"]
    }
  ],
  "additionalProperties": false
}
