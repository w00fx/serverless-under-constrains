{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rua.serverless-under-constraints.invalid/schemas/caller_timeout_rejected.schema.json",
  "title": "caller_timeout_rejected (catalogue group B, row 43)",
  "description": "Controller journal: a caller timeout that cannot signal (design §9.11): before the commit (treatment ARMED), not the targeted attempt (COMMITTED_WAITING), an invalid event, or a CONTROL trial with no treatment item (BR-RUA-025).",
  "type": "object",
  "allOf": [
    {
      "$ref": "_defs.schema.json#/$defs/event_envelope"
    },
    {
      "if": {
        "required": ["reason"],
        "properties": {
          "reason": {
            "const": "INVALID_EVENT"
          }
        }
      },
      "then": {},
      "else": {
        "properties": {
          "caller_timeout_event_id": true,
          "attempt_id": true
        },
        "required": ["caller_timeout_event_id", "attempt_id"]
      }
    },
    {
      "if": {
        "required": ["reason"],
        "properties": {
          "reason": {
            "const": "CONTROL_TRIAL"
          }
        }
      },
      "then": {
        "properties": {
          "treatment_state": false
        }
      }
    },
    {
      "if": {
        "required": ["reason"],
        "properties": {
          "reason": {
            "const": "BEFORE_COMMIT"
          }
        }
      },
      "then": {
        "properties": {
          "treatment_state": {
            "const": "ARMED"
          }
        },
        "required": ["treatment_state"]
      }
    },
    {
      "if": {
        "required": ["reason"],
        "properties": {
          "reason": {
            "const": "NOT_TARGETED"
          }
        }
      },
      "then": {
        "properties": {
          "treatment_state": {
            "const": "COMMITTED_WAITING"
          }
        },
        "required": ["treatment_state"]
      }
    }
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_type": {
      "const": "caller_timeout_rejected"
    },
    "event_id": true,
    "run_id": true,
    "variant_validation_id": true,
    "transport_probe_id": true,
    "execution_manifest_sha256": true,
    "trial_id": true,
    "trial_manifest_sha256": true,
    "occurred_at": true,
    "source_instance_id": true,
    "source_sequence": true,
    "causation_event_ids": true,
    "source": {
      "enum": ["treatment_controller"]
    },
    "reason": {
      "enum": ["BEFORE_COMMIT", "NOT_TARGETED", "INVALID_EVENT", "CONTROL_TRIAL"]
    },
    "detail": {
      "type": "string",
      "minLength": 1
    },
    "caller_timeout_event_id": {
      "$ref": "_defs.schema.json#/$defs/uuid4"
    },
    "attempt_id": {
      "$ref": "_defs.schema.json#/$defs/uuid4"
    },
    "treatment_state": {
      "enum": [
        "ARMED",
        "COMMITTED_WAITING",
        "TIMEOUT_SIGNALLED",
        "TIMEOUT_OBSERVED",
        "RESPONSE_RELEASED",
        "SAFETY_RELEASED"
      ]
    }
  },
  "required": ["schema_version", "record_type", "source", "reason", "detail"],
  "additionalProperties": false
}
