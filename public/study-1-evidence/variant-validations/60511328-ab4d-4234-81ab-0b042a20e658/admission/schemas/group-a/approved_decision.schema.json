{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rua.serverless-under-constraints.invalid/schemas/approved_decision.schema.json",
  "title": "approved_decision (CTR-RUA-006)",
  "description": "The fixed resolved authorization for one full refund. Exactly the CTR-RUA-006 fields. Equality of approved_amount_minor with the payment's captured_amount_minor is a cross-record admission rule (BR-RUA-017, D-31), not a schema rule.",
  "type": "object",
  "properties": {
    "schema_version": { "const": 1 },
    "record_type": { "const": "approved_decision" },
    "refund_request_id": { "$ref": "_defs.schema.json#/$defs/nonempty_trimmed" },
    "payment_id": { "$ref": "_defs.schema.json#/$defs/nonempty_trimmed" },
    "decision": { "const": "APPROVED" },
    "approved_amount_minor": { "$ref": "_defs.schema.json#/$defs/amount_minor" },
    "currency": { "const": "BRL" }
  },
  "required": [
    "schema_version",
    "record_type",
    "refund_request_id",
    "payment_id",
    "decision",
    "approved_amount_minor",
    "currency"
  ],
  "additionalProperties": false
}
