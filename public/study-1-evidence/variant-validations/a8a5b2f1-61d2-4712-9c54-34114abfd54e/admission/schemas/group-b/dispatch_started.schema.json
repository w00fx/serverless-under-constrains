{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rua.serverless-under-constraints.invalid/schemas/dispatch_started.schema.json",
  "title": "dispatch_started (catalogue group B, row 23)",
  "description": "Caller journal: written with the conditional PRE_DISPATCH -> DISPATCHED transition immediately before transport; the monotonic origin event of the attempt. dispatch_at and deadline_at are diagnostic wall times; deadline_ns is the application deadline in source-local nanoseconds (BR-RUA-021, BR-RUA-023).",
  "type": "object",
  "allOf": [
    {
      "$ref": "_defs.schema.json#/$defs/event_envelope"
    }
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_type": {
      "const": "dispatch_started"
    },
    "event_id": true,
    "run_id": true,
    "variant_validation_id": true,
    "transport_probe_id": true,
    "execution_manifest_sha256": true,
    "trial_id": true,
    "trial_manifest_sha256": true,
    "occurred_at": true,
    "source_instance_id": true,
    "source_sequence": true,
    "causation_event_ids": true,
    "source": {
      "enum": ["conventional_caller", "durable_caller", "probe_caller"]
    },
    "attempt_id": {
      "$ref": "_defs.schema.json#/$defs/uuid4"
    },
    "provider_request_id": {
      "$ref": "_defs.schema.json#/$defs/uuid4"
    },
    "refund_request_id": {
      "$ref": "_defs.schema.json#/$defs/nonempty_trimmed"
    },
    "dispatch_at": {
      "$ref": "_defs.schema.json#/$defs/utc_millis"
    },
    "deadline_at": {
      "$ref": "_defs.schema.json#/$defs/utc_millis"
    },
    "deadline_ns": {
      "$ref": "_defs.schema.json#/$defs/monotonic_ns"
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "source",
    "attempt_id",
    "provider_request_id",
    "refund_request_id",
    "dispatch_at",
    "deadline_at",
    "deadline_ns"
  ],
  "additionalProperties": false
}
