{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rua.serverless-under-constraints.invalid/schemas/probe_usability_assessment.schema.json",
  "title": "probe_usability_assessment (catalogue group C, row 81)",
  "description": "evidence/verifications/ and admission evidence (BR-RUA-026, AC-RUA-056; design §8.11): whether a probe may be selected. usable exactly when every condition holds and there is no reason: a passing verdict, a valid and faithful probe, verified evidence, late evidence none or consistent, clean effective closure, no known safety breach, an eligible package and an indexed transport-scope snapshot. Each unmet condition adds its reason code.",
  "type": "object",
  "allOf": [
    {
      "if": {
        "properties": {
          "probe_usability": {
            "const": "usable"
          }
        },
        "required": ["probe_usability"]
      },
      "then": {
        "properties": {
          "reasons": {
            "type": "array",
            "maxItems": 0
          },
          "transport_probe_verdict": {
            "const": "pass"
          },
          "probe_validity": {
            "const": "valid"
          },
          "treatment_fidelity": {
            "const": "verified"
          },
          "evidence_integrity": {
            "const": "verified"
          },
          "late_evidence_status": {
            "enum": ["none", "consistent"]
          },
          "effective_cleanup_status": {
            "const": "succeeded"
          },
          "effective_leak_audit_status": {
            "const": "clean"
          },
          "effective_lease_status": {
            "const": "released"
          },
          "safety_status": {
            "enum": ["within_limits", "unverified"]
          },
          "package_eligibility": {
            "const": "eligible"
          },
          "transport_scope_snapshot_sha256": true
        },
        "required": ["transport_scope_snapshot_sha256"]
      },
      "else": {
        "properties": {
          "reasons": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_type": {
      "const": "probe_usability_assessment"
    },
    "transport_probe_id": {
      "$ref": "_defs.schema.json#/$defs/uuid4"
    },
    "run_id": false,
    "variant_validation_id": false,
    "original_package_index_sha256": {
      "$ref": "_defs.schema.json#/$defs/sha256"
    },
    "selected_amendment_head_sha256": {
      "oneOf": [
        {
          "$ref": "_defs.schema.json#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "probe_usability": {
      "enum": ["usable", "not_usable"]
    },
    "reasons": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "_defs.schema.json#/$defs/structured_reason"
          },
          {
            "type": "object",
            "properties": {
              "code": {
                "enum": [
                  "PROBE_NOT_PASSING",
                  "PROBE_INVALID_OR_UNFAITHFUL",
                  "EVIDENCE_NOT_VERIFIED",
                  "LATE_EVIDENCE_CONTRADICTORY",
                  "LATE_EVIDENCE_UNVERIFIED",
                  "OPERATIONAL_CLOSURE_NOT_CLEAN",
                  "KNOWN_SAFETY_BREACH",
                  "PACKAGE_NOT_VERIFIED",
                  "NO_TRANSPORT_SCOPE_SNAPSHOT"
                ]
              }
            }
          }
        ]
      }
    },
    "transport_probe_verdict": {
      "enum": ["pass", "fail", "indeterminate"]
    },
    "probe_validity": {
      "enum": ["valid", "invalid", "indeterminate"]
    },
    "treatment_fidelity": {
      "enum": ["verified", "invalid", "unverified"]
    },
    "evidence_integrity": {
      "enum": ["verified", "invalid", "unverified"]
    },
    "late_evidence_status": {
      "enum": ["none", "consistent", "contradictory", "unverified"]
    },
    "effective_cleanup_status": {
      "enum": ["succeeded", "partial", "failed", "unverified"]
    },
    "effective_leak_audit_status": {
      "enum": ["clean", "leaks_detected", "inconclusive", "unverified"]
    },
    "effective_lease_status": {
      "enum": ["released", "recovery_required", "unverified"]
    },
    "safety_status": {
      "enum": ["within_limits", "breached", "unverified"]
    },
    "package_eligibility": {
      "enum": ["eligible", "ineligible"]
    },
    "transport_scope_snapshot_sha256": {
      "$ref": "_defs.schema.json#/$defs/sha256"
    },
    "evidence_refs": {
      "$ref": "_defs.schema.json#/$defs/evidence_refs"
    },
    "assessed_at": {
      "$ref": "_defs.schema.json#/$defs/utc_millis"
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "transport_probe_id",
    "original_package_index_sha256",
    "selected_amendment_head_sha256",
    "probe_usability",
    "reasons",
    "transport_probe_verdict",
    "probe_validity",
    "treatment_fidelity",
    "evidence_integrity",
    "late_evidence_status",
    "effective_cleanup_status",
    "effective_leak_audit_status",
    "effective_lease_status",
    "safety_status",
    "package_eligibility",
    "evidence_refs",
    "assessed_at"
  ],
  "additionalProperties": false
}
