{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rua.serverless-under-constraints.invalid/schemas/provider_trial_configuration.schema.json",
  "title": "provider_trial_configuration (BR-RUA-025, BR-RUA-018)",
  "description": "The immutable provider configuration the runner writes to the control table before a trial (or the probe) starts. It declares the active execution identity and frozen manifest digest the provider accepts, the scenario (BR-RUA-025 control integrity requires it to declare CONTROL for a control trial), the single caller registered for in-handler authorization (D-09), the trial's payment, and the provider's safety-release and treatment-polling intervals. A trial-scoped configuration carries the trial identity and a variant caller; a probe configuration has no trial (D-06), registers the probe caller and always declares COMMIT_THEN_TIMEOUT, because the probe exercises the treatment.",
  "type": "object",
  "properties": {
    "schema_version": { "const": 1 },
    "record_type": { "const": "provider_trial_configuration" },
    "run_id": { "$ref": "_defs.schema.json#/$defs/uuid4" },
    "variant_validation_id": { "$ref": "_defs.schema.json#/$defs/uuid4" },
    "transport_probe_id": { "$ref": "_defs.schema.json#/$defs/uuid4" },
    "execution_manifest_sha256": { "$ref": "_defs.schema.json#/$defs/sha256" },
    "trial_id": { "$ref": "_defs.schema.json#/$defs/uuid4" },
    "trial_manifest_sha256": { "$ref": "_defs.schema.json#/$defs/sha256" },
    "scenario": { "enum": ["CONTROL", "COMMIT_THEN_TIMEOUT"] },
    "registered_caller_id": { "enum": ["conventional", "durable", "probe"] },
    "payment_id": { "$ref": "_defs.schema.json#/$defs/nonempty_trimmed" },
    "safety_release_ms": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "treatment_poll_interval_ms": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "written_at": { "$ref": "_defs.schema.json#/$defs/utc_millis" }
  },
  "required": [
    "schema_version",
    "record_type",
    "execution_manifest_sha256",
    "scenario",
    "registered_caller_id",
    "payment_id",
    "safety_release_ms",
    "treatment_poll_interval_ms",
    "written_at"
  ],
  "oneOf": [
    {
      "properties": { "run_id": { "$ref": "_defs.schema.json#/$defs/uuid4" } },
      "required": ["run_id"]
    },
    {
      "properties": { "variant_validation_id": { "$ref": "_defs.schema.json#/$defs/uuid4" } },
      "required": ["variant_validation_id"]
    },
    {
      "properties": { "transport_probe_id": { "$ref": "_defs.schema.json#/$defs/uuid4" } },
      "required": ["transport_probe_id"]
    }
  ],
  "if": {
    "properties": { "transport_probe_id": { "$ref": "_defs.schema.json#/$defs/uuid4" } },
    "required": ["transport_probe_id"]
  },
  "then": {
    "properties": {
      "registered_caller_id": { "const": "probe" },
      "scenario": { "const": "COMMIT_THEN_TIMEOUT" },
      "trial_id": false,
      "trial_manifest_sha256": false
    }
  },
  "else": {
    "properties": {
      "registered_caller_id": { "enum": ["conventional", "durable"] },
      "trial_id": { "$ref": "_defs.schema.json#/$defs/uuid4" },
      "trial_manifest_sha256": { "$ref": "_defs.schema.json#/$defs/sha256" }
    },
    "required": ["trial_id", "trial_manifest_sha256"]
  },
  "additionalProperties": false
}
