{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rua.serverless-under-constraints.invalid/schemas/probe_workload_request.schema.json",
  "title": "probe_workload_request (BR-RUA-027)",
  "description": "The payload the runner sends in its single synchronous invocation of the probe caller. The probe has no trial (D-06): it is identified by transport_probe_id and the frozen execution-manifest digest, and it requests exactly one refund attempt for the declared payment and refund request.",
  "type": "object",
  "properties": {
    "schema_version": { "const": 1 },
    "record_type": { "const": "probe_workload_request" },
    "transport_probe_id": { "$ref": "_defs.schema.json#/$defs/uuid4" },
    "execution_manifest_sha256": { "$ref": "_defs.schema.json#/$defs/sha256" },
    "payment_id": { "$ref": "_defs.schema.json#/$defs/nonempty_trimmed" },
    "refund_request_id": { "$ref": "_defs.schema.json#/$defs/nonempty_trimmed" },
    "amount_minor": { "$ref": "_defs.schema.json#/$defs/amount_minor" },
    "currency": { "const": "BRL" }
  },
  "required": [
    "schema_version",
    "record_type",
    "transport_probe_id",
    "execution_manifest_sha256",
    "payment_id",
    "refund_request_id",
    "amount_minor",
    "currency"
  ],
  "additionalProperties": false
}
