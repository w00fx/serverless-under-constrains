{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rua.serverless-under-constraints.invalid/schemas/cleanup_result.schema.json",
  "title": "cleanup_result (catalogue group C, row 75)",
  "description": "cleanup/cleanup-result.json (BR-RUA-048, BR-RUA-049, BR-RUA-050, BR-RUA-051; design §10.4, §8.18): the twelve steps, every discovered resource with its ownership basis and action, stopped durable executions, deleted captured DLQ messages and the duration breach. Ambiguous ownership is never deleted; succeeded means no deletion failed; partial means some did. A not_started or running cleanup has no completion time; the verifier, not the schema, refuses a non-terminal final status.",
  "type": "object",
  "$defs": {
    "cleanup_step": {
      "type": "object",
      "properties": {
        "step": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "status": {
          "enum": ["started", "succeeded", "failed", "skipped"]
        },
        "started_at": {
          "$ref": "_defs.schema.json#/$defs/utc_millis"
        },
        "completed_at": {
          "$ref": "_defs.schema.json#/$defs/utc_millis"
        },
        "reasons": {
          "$ref": "_defs.schema.json#/$defs/structured_reasons"
        }
      },
      "required": ["step", "status", "reasons"],
      "additionalProperties": false
    },
    "cleanup_resource": {
      "type": "object",
      "properties": {
        "resource_type": {
          "type": "string",
          "minLength": 1
        },
        "resource_identifier": {
          "type": "string",
          "minLength": 1
        },
        "ownership_basis": {
          "enum": [
            "recorded_stack",
            "resource_manifest_and_tags",
            "tags_name_type_created_after_freeze",
            "ambiguous",
            "excluded_baseline"
          ]
        },
        "action": {
          "enum": ["DELETED", "ALREADY_ABSENT", "DELETE_FAILED", "SKIPPED_AMBIGUOUS", "EXCLUDED_BASELINE"]
        },
        "reasons": {
          "$ref": "_defs.schema.json#/$defs/structured_reasons"
        }
      },
      "required": ["resource_type", "resource_identifier", "ownership_basis", "action", "reasons"],
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "SKIPPED_AMBIGUOUS"
              }
            },
            "required": ["action"]
          },
          "then": {
            "properties": {
              "ownership_basis": {
                "const": "ambiguous"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "EXCLUDED_BASELINE"
              }
            },
            "required": ["action"]
          },
          "then": {
            "properties": {
              "ownership_basis": {
                "const": "excluded_baseline"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "enum": ["DELETED", "ALREADY_ABSENT", "DELETE_FAILED"]
              }
            },
            "required": ["action"]
          },
          "then": {
            "properties": {
              "ownership_basis": {
                "enum": ["recorded_stack", "resource_manifest_and_tags", "tags_name_type_created_after_freeze"]
              }
            }
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "$ref": "_defs.schema.json#/$defs/execution_identity"
    },
    {
      "if": {
        "properties": {
          "cleanup_status": {
            "enum": ["not_started", "running"]
          }
        },
        "required": ["cleanup_status"]
      },
      "then": {
        "properties": {
          "completed_at": false
        }
      },
      "else": {
        "properties": {
          "completed_at": true
        },
        "required": ["completed_at"]
      }
    },
    {
      "if": {
        "properties": {
          "cleanup_status": {
            "const": "succeeded"
          }
        },
        "required": ["cleanup_status"]
      },
      "then": {
        "properties": {
          "resources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "action": {
                  "not": {
                    "const": "DELETE_FAILED"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "cleanup_status": {
            "const": "partial"
          }
        },
        "required": ["cleanup_status"]
      },
      "then": {
        "properties": {
          "resources": {
            "type": "array",
            "contains": {
              "type": "object",
              "properties": {
                "action": {
                  "const": "DELETE_FAILED"
                }
              },
              "required": ["action"]
            }
          }
        }
      }
    }
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_type": {
      "const": "cleanup_result"
    },
    "run_id": {
      "$ref": "_defs.schema.json#/$defs/uuid4"
    },
    "variant_validation_id": {
      "$ref": "_defs.schema.json#/$defs/uuid4"
    },
    "transport_probe_id": {
      "$ref": "_defs.schema.json#/$defs/uuid4"
    },
    "trial_id": false,
    "trial_manifest_sha256": false,
    "execution_manifest_sha256": {
      "$ref": "_defs.schema.json#/$defs/sha256"
    },
    "cleanup_mode": {
      "enum": ["NORMAL", "EMERGENCY"]
    },
    "cleanup_status": {
      "enum": ["not_started", "running", "succeeded", "partial", "failed"]
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cleanup_step"
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cleanup_resource"
      }
    },
    "stopped_durable_execution_arns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "deleted_dlq_message_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "duration_breach": {
      "type": "boolean"
    },
    "started_at": {
      "$ref": "_defs.schema.json#/$defs/utc_millis"
    },
    "completed_at": {
      "$ref": "_defs.schema.json#/$defs/utc_millis"
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "execution_manifest_sha256",
    "cleanup_mode",
    "cleanup_status",
    "steps",
    "resources",
    "stopped_durable_execution_arns",
    "deleted_dlq_message_ids",
    "duration_breach",
    "started_at"
  ],
  "additionalProperties": false
}
