{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rua.serverless-under-constraints.invalid/schemas/provider_refund_call.schema.json",
  "title": "provider_refund_call (BR-RUA-018, BR-RUA-028)",
  "description": "The payload a caller sends to the controlled provider through the shared provider client. It names the caller, exactly one execution identity with its frozen manifest digest, the physical identities of the attempt (INV-RUA-001) and the requested effect. Trial-scoped calls (run or variant validation) carry trial_id and trial_manifest_sha256 and come from a variant caller; a transport-probe call has no trial (D-06) and comes from the probe caller. The currency is any ISO 4217-shaped code so that the provider, not the schema, judges a currency mismatch against the payment (BR-RUA-018 acceptance order, design §9.10).",
  "type": "object",
  "properties": {
    "schema_version": { "const": 1 },
    "record_type": { "const": "provider_refund_call" },
    "caller_id": { "enum": ["conventional", "durable", "probe"] },
    "run_id": { "$ref": "_defs.schema.json#/$defs/uuid4" },
    "variant_validation_id": { "$ref": "_defs.schema.json#/$defs/uuid4" },
    "transport_probe_id": { "$ref": "_defs.schema.json#/$defs/uuid4" },
    "execution_manifest_sha256": { "$ref": "_defs.schema.json#/$defs/sha256" },
    "trial_id": { "$ref": "_defs.schema.json#/$defs/uuid4" },
    "trial_manifest_sha256": { "$ref": "_defs.schema.json#/$defs/sha256" },
    "attempt_id": { "$ref": "_defs.schema.json#/$defs/uuid4" },
    "provider_request_id": { "$ref": "_defs.schema.json#/$defs/uuid4" },
    "refund_request_id": { "$ref": "_defs.schema.json#/$defs/nonempty_trimmed" },
    "payment_id": { "$ref": "_defs.schema.json#/$defs/nonempty_trimmed" },
    "amount_minor": { "$ref": "_defs.schema.json#/$defs/amount_minor" },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
  },
  "required": [
    "schema_version",
    "record_type",
    "caller_id",
    "execution_manifest_sha256",
    "attempt_id",
    "provider_request_id",
    "refund_request_id",
    "payment_id",
    "amount_minor",
    "currency"
  ],
  "oneOf": [
    {
      "properties": { "run_id": { "$ref": "_defs.schema.json#/$defs/uuid4" } },
      "required": ["run_id"]
    },
    {
      "properties": { "variant_validation_id": { "$ref": "_defs.schema.json#/$defs/uuid4" } },
      "required": ["variant_validation_id"]
    },
    {
      "properties": { "transport_probe_id": { "$ref": "_defs.schema.json#/$defs/uuid4" } },
      "required": ["transport_probe_id"]
    }
  ],
  "if": {
    "properties": { "transport_probe_id": { "$ref": "_defs.schema.json#/$defs/uuid4" } },
    "required": ["transport_probe_id"]
  },
  "then": {
    "properties": {
      "caller_id": { "const": "probe" },
      "trial_id": false,
      "trial_manifest_sha256": false
    }
  },
  "else": {
    "properties": {
      "caller_id": { "enum": ["conventional", "durable"] },
      "trial_id": { "$ref": "_defs.schema.json#/$defs/uuid4" },
      "trial_manifest_sha256": { "$ref": "_defs.schema.json#/$defs/sha256" }
    },
    "required": ["trial_id", "trial_manifest_sha256"]
  },
  "additionalProperties": false
}
