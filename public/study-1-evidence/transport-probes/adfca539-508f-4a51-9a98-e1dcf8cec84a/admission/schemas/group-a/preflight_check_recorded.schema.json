{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rua.serverless-under-constraints.invalid/schemas/preflight_check_recorded.schema.json",
  "title": "preflight_check_recorded (BR-RUA-039, BR-RUA-046, BR-RUA-055)",
  "description": "One line of an admission attempt's preflight journal (JSONL): one read-only admission step A1..A15 (design §10.1). It records the boundary checked (subject), the declared limit or expected value, the observed value when available (omitted, never null, when unavailable), the result, evidence and check time (BR-RUA-046). sequence is dense from 1 within the attempt. A failed check names its AC-RUA-014 rejection class and at least one reason; a passed check names none.",
  "type": "object",
  "properties": {
    "schema_version": { "const": 1 },
    "record_type": { "const": "preflight_check_recorded" },
    "admission_attempt_id": { "$ref": "_defs.schema.json#/$defs/uuid4" },
    "sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "check_id": { "type": "string", "pattern": "^A([1-9]|1[0-5])$" },
    "subject": { "type": "string", "minLength": 1 },
    "expected": { "$ref": "#/$defs/check_value_8" },
    "observed": { "$ref": "#/$defs/check_value_8" },
    "result": { "enum": ["passed", "failed"] },
    "rejection_class": {
      "enum": [
        "FINANCIAL_INPUT",
        "IDENTITY",
        "SOURCE_PROVENANCE",
        "ACCOUNT",
        "REGION",
        "SAFETY",
        "QUALIFICATION",
        "COORDINATION_CONFIGURATION"
      ]
    },
    "reasons": { "$ref": "_defs.schema.json#/$defs/structured_reasons" },
    "evidence_refs": { "$ref": "_defs.schema.json#/$defs/evidence_refs" },
    "checked_at": { "$ref": "_defs.schema.json#/$defs/utc_millis" }
  },
  "required": [
    "schema_version",
    "record_type",
    "admission_attempt_id",
    "sequence",
    "check_id",
    "subject",
    "expected",
    "result",
    "reasons",
    "evidence_refs",
    "checked_at"
  ],
  "if": {
    "properties": { "result": { "const": "failed" } },
    "required": ["result"]
  },
  "then": {
    "properties": {
      "rejection_class": {
        "enum": [
          "FINANCIAL_INPUT",
          "IDENTITY",
          "SOURCE_PROVENANCE",
          "ACCOUNT",
          "REGION",
          "SAFETY",
          "QUALIFICATION",
          "COORDINATION_CONFIGURATION"
        ]
      },
      "reasons": { "type": "array", "minItems": 1 }
    },
    "required": ["rejection_class"]
  },
  "else": {
    "properties": {
      "rejection_class": false,
      "reasons": { "type": "array", "maxItems": 0 }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "check_value_8": {
      "description": "A declared limit or observed value as record JSON (BR-RUA-033): a string, number, boolean, array or object, never null at any depth, whose object member names are all snake_case. An unavailable observed value is omitted. Arrays and objects nest at most 8 levels deep (PREFLIGHT_VALUE_MAX_DEPTH): check_value_n admits containers of check_value_(n-1), and check_value_1 admits containers of scalars only. The definition is unrolled instead of self-recursive because Ajv validates a recursive $ref with one recursive call per instance nesting level, so a deeply nested value threw RangeError instead of being rejected (Owner amendments A-02, A-05). The admission checks of design §10.1 record scalars and shallow objects, far below the bound.",
      "anyOf": [
        { "$ref": "#/$defs/check_scalar" },
        { "type": "array", "items": { "$ref": "#/$defs/check_value_7" } },
        {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
          "additionalProperties": { "$ref": "#/$defs/check_value_7" }
        }
      ]
    },
    "check_value_7": {
      "description": "A check value whose arrays and objects nest at most 7 levels deep.",
      "anyOf": [
        { "$ref": "#/$defs/check_scalar" },
        { "type": "array", "items": { "$ref": "#/$defs/check_value_6" } },
        {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
          "additionalProperties": { "$ref": "#/$defs/check_value_6" }
        }
      ]
    },
    "check_value_6": {
      "description": "A check value whose arrays and objects nest at most 6 levels deep.",
      "anyOf": [
        { "$ref": "#/$defs/check_scalar" },
        { "type": "array", "items": { "$ref": "#/$defs/check_value_5" } },
        {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
          "additionalProperties": { "$ref": "#/$defs/check_value_5" }
        }
      ]
    },
    "check_value_5": {
      "description": "A check value whose arrays and objects nest at most 5 levels deep.",
      "anyOf": [
        { "$ref": "#/$defs/check_scalar" },
        { "type": "array", "items": { "$ref": "#/$defs/check_value_4" } },
        {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
          "additionalProperties": { "$ref": "#/$defs/check_value_4" }
        }
      ]
    },
    "check_value_4": {
      "description": "A check value whose arrays and objects nest at most 4 levels deep.",
      "anyOf": [
        { "$ref": "#/$defs/check_scalar" },
        { "type": "array", "items": { "$ref": "#/$defs/check_value_3" } },
        {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
          "additionalProperties": { "$ref": "#/$defs/check_value_3" }
        }
      ]
    },
    "check_value_3": {
      "description": "A check value whose arrays and objects nest at most 3 levels deep.",
      "anyOf": [
        { "$ref": "#/$defs/check_scalar" },
        { "type": "array", "items": { "$ref": "#/$defs/check_value_2" } },
        {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
          "additionalProperties": { "$ref": "#/$defs/check_value_2" }
        }
      ]
    },
    "check_value_2": {
      "description": "A check value whose arrays and objects nest at most 2 levels deep.",
      "anyOf": [
        { "$ref": "#/$defs/check_scalar" },
        { "type": "array", "items": { "$ref": "#/$defs/check_value_1" } },
        {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
          "additionalProperties": { "$ref": "#/$defs/check_value_1" }
        }
      ]
    },
    "check_value_1": {
      "description": "A check value whose arrays and objects nest at most 1 level deep.",
      "anyOf": [
        { "$ref": "#/$defs/check_scalar" },
        { "type": "array", "items": { "$ref": "#/$defs/check_scalar" } },
        {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
          "additionalProperties": { "$ref": "#/$defs/check_scalar" }
        }
      ]
    },
    "check_scalar": {
      "description": "A non-null JSON scalar: the innermost level of a check value.",
      "anyOf": [{ "type": "string" }, { "type": "number" }, { "type": "boolean" }]
    }
  }
}
