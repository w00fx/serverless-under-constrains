{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rua.serverless-under-constraints.invalid/schemas/execution_manifest.schema.json",
  "title": "execution_manifest (BR-RUA-040, BR-RUA-019, BR-RUA-007, OR-RUA-001..005, CA-1)",
  "description": "The canonical execution manifest, frozen before the first mutation. It declares the execution identity and the declared trial order (four trials for a run in the BR-RUA-019 order, two trials of one variant for a variant validation in the BR-RUA-038 order, none for a transport probe), seed 1, the financial, timing, retry, warm-up (addendum §2) and safety inputs, the admitted environment (account, Region, coordination), the clean source provenance, the schema-file digests, the selected qualification (null for a probe, which creates the qualification it will be judged on), the transport-scope snapshot digest, the frozen deployment assembly, the conservative estimates, the declared CA-1 clock assumption and the declared variant differences (BR-RUA-007). Trial-id uniqueness is a code-level admission check.",
  "type": "object",
  "properties": {
    "schema_version": { "const": 1 },
    "record_type": { "const": "execution_manifest" },
    "execution_kind": { "enum": ["RUN", "TRANSPORT_PROBE", "VARIANT_VALIDATION"] },
    "run_id": { "$ref": "_defs.schema.json#/$defs/uuid4" },
    "variant_validation_id": { "$ref": "_defs.schema.json#/$defs/uuid4" },
    "transport_probe_id": { "$ref": "_defs.schema.json#/$defs/uuid4" },
    "variant_id": { "enum": ["conventional", "durable"] },
    "admission_attempt_id": { "$ref": "_defs.schema.json#/$defs/uuid4" },
    "frozen_at": { "$ref": "_defs.schema.json#/$defs/utc_millis" },
    "seed": { "const": 1 },
    "trials": { "type": "array", "items": { "$ref": "#/$defs/trial_entry" } },
    "financial_inputs": { "$ref": "#/$defs/financial_inputs" },
    "timing": { "$ref": "#/$defs/timing" },
    "provider_warmup": {
      "type": "object",
      "properties": { "invocations_per_trial": { "const": 1 } },
      "required": ["invocations_per_trial"],
      "additionalProperties": false
    },
    "safety": { "$ref": "#/$defs/safety" },
    "environment": { "$ref": "#/$defs/environment" },
    "source": { "$ref": "#/$defs/source" },
    "schema_files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "record_type": { "$ref": "_defs.schema.json#/$defs/record_type_name" },
          "relative_path": { "$ref": "_defs.schema.json#/$defs/package_relative_path" },
          "sha256": { "$ref": "_defs.schema.json#/$defs/sha256" }
        },
        "required": ["record_type", "relative_path", "sha256"],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "qualification": {
      "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/qualification" }]
    },
    "transport_scope_snapshot_sha256": { "$ref": "_defs.schema.json#/$defs/sha256" },
    "deployment_assembly": {
      "type": "object",
      "properties": {
        "assembly_path": { "$ref": "_defs.schema.json#/$defs/package_relative_path" },
        "inventory_sha256": { "$ref": "_defs.schema.json#/$defs/sha256" },
        "template_path": { "$ref": "_defs.schema.json#/$defs/package_relative_path" },
        "template_sha256": { "$ref": "_defs.schema.json#/$defs/sha256" }
      },
      "required": ["assembly_path", "inventory_sha256", "template_path", "template_sha256"],
      "additionalProperties": false
    },
    "estimates": {
      "type": "object",
      "properties": {
        "estimated_cost_usd": { "$ref": "_defs.schema.json#/$defs/money_decimal" },
        "resource_counts": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
          "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "minProperties": 1
        }
      },
      "required": ["estimated_cost_usd", "resource_counts"],
      "additionalProperties": false
    },
    "clock_assumptions": {
      "type": "array",
      "prefixItems": [{ "$ref": "#/$defs/clock_assumption_ca_1" }],
      "minItems": 1,
      "maxItems": 1,
      "items": false
    },
    "declared_variant_differences": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "parameter": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "conventional": { "$ref": "#/$defs/declared_value" },
          "durable": { "$ref": "#/$defs/declared_value" },
          "basis": { "type": "string", "minLength": 1 }
        },
        "required": ["parameter", "conventional", "durable", "basis"],
        "additionalProperties": false
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "execution_kind",
    "admission_attempt_id",
    "frozen_at",
    "seed",
    "trials",
    "financial_inputs",
    "timing",
    "provider_warmup",
    "safety",
    "environment",
    "source",
    "schema_files",
    "qualification",
    "transport_scope_snapshot_sha256",
    "deployment_assembly",
    "estimates",
    "clock_assumptions",
    "declared_variant_differences"
  ],
  "oneOf": [
    {
      "properties": { "run_id": { "$ref": "_defs.schema.json#/$defs/uuid4" } },
      "required": ["run_id"]
    },
    {
      "properties": { "variant_validation_id": { "$ref": "_defs.schema.json#/$defs/uuid4" } },
      "required": ["variant_validation_id"]
    },
    {
      "properties": { "transport_probe_id": { "$ref": "_defs.schema.json#/$defs/uuid4" } },
      "required": ["transport_probe_id"]
    }
  ],
  "allOf": [
    {
      "if": { "properties": { "execution_kind": { "const": "RUN" } }, "required": ["execution_kind"] },
      "then": {
        "properties": {
          "run_id": { "$ref": "_defs.schema.json#/$defs/uuid4" },
          "variant_id": false,
          "trials": {
            "type": "array",
            "prefixItems": [
              { "$ref": "#/$defs/run_trial_1" },
              { "$ref": "#/$defs/run_trial_2" },
              { "$ref": "#/$defs/run_trial_3" },
              { "$ref": "#/$defs/run_trial_4" }
            ],
            "minItems": 4,
            "maxItems": 4
          },
          "qualification": { "$ref": "#/$defs/qualification" }
        },
        "required": ["run_id"]
      }
    },
    {
      "if": {
        "properties": { "execution_kind": { "const": "VARIANT_VALIDATION" } },
        "required": ["execution_kind"]
      },
      "then": {
        "properties": {
          "variant_validation_id": { "$ref": "_defs.schema.json#/$defs/uuid4" },
          "variant_id": { "enum": ["conventional", "durable"] },
          "trials": {
            "type": "array",
            "prefixItems": [{ "$ref": "#/$defs/validation_trial_1" }, { "$ref": "#/$defs/validation_trial_2" }],
            "minItems": 2,
            "maxItems": 2
          },
          "qualification": { "$ref": "#/$defs/qualification" }
        },
        "required": ["variant_validation_id", "variant_id"]
      }
    },
    {
      "if": {
        "properties": { "execution_kind": { "const": "TRANSPORT_PROBE" } },
        "required": ["execution_kind"]
      },
      "then": {
        "properties": {
          "transport_probe_id": { "$ref": "_defs.schema.json#/$defs/uuid4" },
          "variant_id": false,
          "trials": { "type": "array", "maxItems": 0 },
          "qualification": { "type": "null" }
        },
        "required": ["transport_probe_id"]
      }
    },
    {
      "if": { "properties": { "variant_id": { "const": "conventional" } }, "required": ["variant_id"] },
      "then": {
        "properties": {
          "trials": {
            "type": "array",
            "items": { "type": "object", "properties": { "variant_id": { "const": "conventional" } } }
          }
        }
      }
    },
    {
      "if": { "properties": { "variant_id": { "const": "durable" } }, "required": ["variant_id"] },
      "then": {
        "properties": {
          "trials": {
            "type": "array",
            "items": { "type": "object", "properties": { "variant_id": { "const": "durable" } } }
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "trial_entry": {
      "type": "object",
      "properties": {
        "sequence": { "type": "integer", "minimum": 1, "maximum": 4 },
        "trial_id": { "$ref": "_defs.schema.json#/$defs/uuid4" },
        "variant_id": { "enum": ["conventional", "durable"] },
        "scenario": { "enum": ["CONTROL", "COMMIT_THEN_TIMEOUT"] }
      },
      "required": ["sequence", "trial_id", "variant_id", "scenario"],
      "additionalProperties": false
    },
    "run_trial_1": {
      "type": "object",
      "properties": {
        "sequence": { "const": 1 },
        "variant_id": { "const": "conventional" },
        "scenario": { "const": "CONTROL" }
      }
    },
    "run_trial_2": {
      "type": "object",
      "properties": {
        "sequence": { "const": 2 },
        "variant_id": { "const": "durable" },
        "scenario": { "const": "CONTROL" }
      }
    },
    "run_trial_3": {
      "type": "object",
      "properties": {
        "sequence": { "const": 3 },
        "variant_id": { "const": "conventional" },
        "scenario": { "const": "COMMIT_THEN_TIMEOUT" }
      }
    },
    "run_trial_4": {
      "type": "object",
      "properties": {
        "sequence": { "const": 4 },
        "variant_id": { "const": "durable" },
        "scenario": { "const": "COMMIT_THEN_TIMEOUT" }
      }
    },
    "validation_trial_1": {
      "type": "object",
      "properties": { "sequence": { "const": 1 }, "scenario": { "const": "CONTROL" } }
    },
    "validation_trial_2": {
      "type": "object",
      "properties": { "sequence": { "const": 2 }, "scenario": { "const": "COMMIT_THEN_TIMEOUT" } }
    },
    "financial_inputs": {
      "type": "object",
      "properties": {
        "currency": { "const": "BRL" },
        "payment_id": { "$ref": "_defs.schema.json#/$defs/nonempty_trimmed" },
        "captured_amount_minor": { "$ref": "_defs.schema.json#/$defs/amount_minor" },
        "refund_request_id": { "$ref": "_defs.schema.json#/$defs/nonempty_trimmed" },
        "approved_amount_minor": { "$ref": "_defs.schema.json#/$defs/amount_minor" },
        "decision": { "const": "APPROVED" }
      },
      "required": [
        "currency",
        "payment_id",
        "captured_amount_minor",
        "refund_request_id",
        "approved_amount_minor",
        "decision"
      ],
      "additionalProperties": false
    },
    "declared_value": {
      "description": "One variant's value of a declared difference: a non-empty string, a safe integer or a boolean. Never null: a declared difference names a value on both sides.",
      "anyOf": [
        { "type": "string", "minLength": 1 },
        { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 },
        { "type": "boolean" }
      ]
    },
    "positive_ms": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "timing": {
      "type": "object",
      "properties": {
        "provider_client_deadline_ms": { "$ref": "#/$defs/positive_ms" },
        "provider_safety_release_ms": { "$ref": "#/$defs/positive_ms" },
        "provider_execution_timeout_ms": { "$ref": "#/$defs/positive_ms" },
        "conventional_invocation_timeout_ms": { "$ref": "#/$defs/positive_ms" },
        "durable_invocation_timeout_ms": { "$ref": "#/$defs/positive_ms" },
        "conventional_visibility_timeout_ms": { "$ref": "#/$defs/positive_ms" },
        "durable_visibility_timeout_ms": { "$ref": "#/$defs/positive_ms" },
        "durable_retry_delay_ms": { "$ref": "#/$defs/positive_ms" },
        "durable_total_step_attempts": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "durable_execution_timeout_ms": { "$ref": "#/$defs/positive_ms" },
        "max_receive_count": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "observation_deadline_ms": { "$ref": "#/$defs/positive_ms" },
        "stabilization_interval_ms": { "$ref": "#/$defs/positive_ms" },
        "queue_poll_interval_ms": { "$ref": "#/$defs/positive_ms" },
        "treatment_poll_interval_ms": { "$ref": "#/$defs/positive_ms" },
        "retry_jitter": { "const": "NONE" }
      },
      "required": [
        "provider_client_deadline_ms",
        "provider_safety_release_ms",
        "provider_execution_timeout_ms",
        "conventional_invocation_timeout_ms",
        "durable_invocation_timeout_ms",
        "conventional_visibility_timeout_ms",
        "durable_visibility_timeout_ms",
        "durable_retry_delay_ms",
        "durable_total_step_attempts",
        "durable_execution_timeout_ms",
        "max_receive_count",
        "observation_deadline_ms",
        "stabilization_interval_ms",
        "queue_poll_interval_ms",
        "treatment_poll_interval_ms",
        "retry_jitter"
      ],
      "additionalProperties": false
    },
    "safety": {
      "type": "object",
      "properties": {
        "region": { "const": "us-east-1" },
        "active_ms": { "$ref": "#/$defs/positive_ms" },
        "cleanup_ms": { "$ref": "#/$defs/positive_ms" },
        "total_ms": { "$ref": "#/$defs/positive_ms" },
        "ceiling_usd": { "$ref": "_defs.schema.json#/$defs/money_decimal" },
        "concurrent_owners": { "const": 1 }
      },
      "required": ["region", "active_ms", "cleanup_ms", "total_ms", "ceiling_usd", "concurrent_owners"],
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "properties": {
        "environment_input_sha256": { "$ref": "_defs.schema.json#/$defs/sha256" },
        "account_id": { "type": "string", "pattern": "^[0-9]{12}$" },
        "region": { "const": "us-east-1" },
        "coordination_table_arn": {
          "type": "string",
          "pattern": "^arn:aws:dynamodb:[a-z]{2}(-[a-z]+)+-[0-9]+:[0-9]{12}:table/[A-Za-z0-9_.-]{3,255}$"
        },
        "coordination_stack_id": {
          "type": "string",
          "pattern": "^arn:aws:cloudformation:[a-z]{2}(-[a-z]+)+-[0-9]+:[0-9]{12}:stack/[A-Za-z][A-Za-z0-9-]{0,127}/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "coordination_schema_version": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      },
      "required": [
        "environment_input_sha256",
        "account_id",
        "region",
        "coordination_table_arn",
        "coordination_stack_id",
        "coordination_schema_version"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$" },
        "tree_sha": { "type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$" },
        "branch": { "$ref": "_defs.schema.json#/$defs/nonempty_trimmed" },
        "clean_confirmed": { "const": true },
        "lockfile_sha256": { "$ref": "_defs.schema.json#/$defs/sha256" },
        "tool_versions": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
          "additionalProperties": { "$ref": "_defs.schema.json#/$defs/nonempty_trimmed" },
          "minProperties": 1
        },
        "source_provenance_sha256": { "$ref": "_defs.schema.json#/$defs/sha256" }
      },
      "required": [
        "commit_sha",
        "tree_sha",
        "clean_confirmed",
        "lockfile_sha256",
        "tool_versions",
        "source_provenance_sha256"
      ],
      "additionalProperties": false
    },
    "qualification": {
      "type": "object",
      "properties": {
        "transport_probe_id": { "$ref": "_defs.schema.json#/$defs/uuid4" },
        "original_package_index_sha256": { "$ref": "_defs.schema.json#/$defs/sha256" },
        "amendment_head_sha256": { "$ref": "_defs.schema.json#/$defs/sha256" }
      },
      "required": ["transport_probe_id", "original_package_index_sha256"],
      "additionalProperties": false
    },
    "clock_assumption_ca_1": {
      "description": "CA-1 exactly as the spec declares it: the scope and statement are the spec text (the statement's line break joined by one space), so a manifest cannot restate the assumption as a stronger claim.",
      "type": "object",
      "properties": {
        "assumption_id": { "const": "CA-1" },
        "assumption_type": { "const": "clock_alignment" },
        "scope": { "const": "same-account, same-Region AWS Lambda execution environments" },
        "statement": {
          "const": "UTC wall-clock timestamps preserve the ordering of the provider commit and caller timer events for this PoC."
        },
        "status": { "const": "declared_not_service_guaranteed" }
      },
      "required": ["assumption_id", "assumption_type", "scope", "statement", "status"],
      "additionalProperties": false
    }
  }
}
