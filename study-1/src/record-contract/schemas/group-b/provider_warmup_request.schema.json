{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rua.serverless-under-constraints.invalid/schemas/provider_warmup_request.schema.json",
  "title": "provider_warmup_request (catalogue group B, row addendum §2)",
  "description": "Runner -> provider warm-up payload, sent once before a trial publication (or the probe caller invocation) after the controller canary. trial_id names the trial about to start as a correlation field only; the request carries no trial manifest digest and never touches trial partitions (addendum §2).",
  "type": "object",
  "allOf": [
    {
      "$ref": "_defs.schema.json#/$defs/execution_identity"
    }
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_type": {
      "const": "provider_warmup_request"
    },
    "run_id": true,
    "variant_validation_id": true,
    "transport_probe_id": true,
    "execution_manifest_sha256": {
      "$ref": "_defs.schema.json#/$defs/sha256"
    },
    "trial_id": {
      "$ref": "_defs.schema.json#/$defs/uuid4"
    },
    "trial_manifest_sha256": false,
    "warmup_id": {
      "$ref": "_defs.schema.json#/$defs/uuid4"
    }
  },
  "required": ["schema_version", "record_type", "execution_manifest_sha256", "warmup_id"],
  "additionalProperties": false
}
