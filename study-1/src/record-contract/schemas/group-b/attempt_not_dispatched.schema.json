{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rua.serverless-under-constraints.invalid/schemas/attempt_not_dispatched.schema.json",
  "title": "attempt_not_dispatched (catalogue group B, row 22)",
  "description": "Caller journal: written with the conditional PRE_DISPATCH -> NOT_DISPATCHED transition, the only proof that an attempt failed before provider-client dispatch began (BR-RUA-021, AC-RUA-015).",
  "type": "object",
  "allOf": [
    {
      "$ref": "_defs.schema.json#/$defs/event_envelope"
    }
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_type": {
      "const": "attempt_not_dispatched"
    },
    "event_id": true,
    "run_id": true,
    "variant_validation_id": true,
    "transport_probe_id": true,
    "execution_manifest_sha256": true,
    "trial_id": true,
    "trial_manifest_sha256": true,
    "occurred_at": true,
    "source_instance_id": true,
    "source_sequence": true,
    "causation_event_ids": true,
    "source": {
      "enum": ["conventional_caller", "durable_caller", "probe_caller"]
    },
    "attempt_id": {
      "$ref": "_defs.schema.json#/$defs/uuid4"
    },
    "provider_request_id": {
      "$ref": "_defs.schema.json#/$defs/uuid4"
    },
    "refund_request_id": {
      "$ref": "_defs.schema.json#/$defs/nonempty_trimmed"
    },
    "failure": {
      "allOf": [
        {
          "$ref": "_defs.schema.json#/$defs/structured_reason"
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "enum": ["CALL_BUILD_FAILED", "DISPATCH_TRANSITION_REJECTED"]
            }
          }
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "source",
    "attempt_id",
    "provider_request_id",
    "refund_request_id",
    "failure"
  ],
  "additionalProperties": false
}
