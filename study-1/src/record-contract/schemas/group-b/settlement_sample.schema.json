{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rua.serverless-under-constraints.invalid/schemas/settlement_sample.schema.json",
  "title": "settlement_sample (catalogue group B, row 58)",
  "description": "JSONL line of settlement/settlement-samples.jsonl: one settlement observation in the exact shape the BR-RUA-032 evaluator reads (design §5.3 SettlementSample), including the D-32 pre-freeze recheck. Trial samples carry the trial identity; probe samples do not.",
  "type": "object",
  "$defs": {
    "queue_counters": {
      "type": "object",
      "properties": {
        "visible": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "in_flight": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "delayed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["visible", "in_flight", "delayed"],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "$ref": "_defs.schema.json#/$defs/execution_identity"
    }
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_type": {
      "const": "settlement_sample"
    },
    "run_id": true,
    "variant_validation_id": true,
    "transport_probe_id": true,
    "execution_manifest_sha256": {
      "$ref": "_defs.schema.json#/$defs/sha256"
    },
    "trial_id": {
      "$ref": "_defs.schema.json#/$defs/uuid4"
    },
    "trial_manifest_sha256": {
      "$ref": "_defs.schema.json#/$defs/sha256"
    },
    "observed_at": {
      "$ref": "_defs.schema.json#/$defs/utc_millis"
    },
    "phase": {
      "enum": ["observation", "pre_freeze_recheck"]
    },
    "publication_stopped": {
      "type": "boolean"
    },
    "processing_terminal": {
      "type": "boolean"
    },
    "inner_executions_terminal": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "const": "not_applicable"
        }
      ]
    },
    "provider_active_calls": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "provider_held_barriers": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "provider_pending_releases": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "treatment_terminal": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "const": "not_applicable"
        }
      ]
    },
    "ledger_snapshot_possible": {
      "type": "boolean"
    },
    "source_queue": {
      "anyOf": [
        {
          "$ref": "#/$defs/queue_counters"
        },
        {
          "enum": ["not_applicable", "unavailable"]
        }
      ]
    },
    "dlq": {
      "anyOf": [
        {
          "$ref": "#/$defs/queue_counters"
        },
        {
          "enum": ["not_applicable", "unavailable"]
        }
      ]
    },
    "correlated_dlq_message_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "dlq_captured_message_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "correlated_event_watermark": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "ledger_item_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "execution_manifest_sha256",
    "observed_at",
    "phase",
    "publication_stopped",
    "processing_terminal",
    "inner_executions_terminal",
    "provider_active_calls",
    "provider_held_barriers",
    "provider_pending_releases",
    "treatment_terminal",
    "ledger_snapshot_possible",
    "source_queue",
    "dlq",
    "correlated_dlq_message_ids",
    "dlq_captured_message_ids",
    "correlated_event_watermark",
    "ledger_item_count"
  ],
  "dependentRequired": {
    "trial_id": ["trial_manifest_sha256"],
    "trial_manifest_sha256": ["trial_id"]
  },
  "additionalProperties": false
}
