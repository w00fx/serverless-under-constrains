{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rua.serverless-under-constraints.invalid/schemas/queue_observation.schema.json",
  "title": "queue_observation (catalogue group B, row 57)",
  "description": "JSONL line of trials/<t>/queues/{source,dlq}-observations.jsonl: one approximate counter read of a variant queue (BR-RUA-032, BR-RUA-037). A successful read carries the three counters; a failed read carries its error code and is never quiet.",
  "type": "object",
  "$defs": {
    "queue_counters": {
      "type": "object",
      "properties": {
        "visible": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "in_flight": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "delayed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["visible", "in_flight", "delayed"],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "$ref": "_defs.schema.json#/$defs/execution_identity"
    },
    {
      "if": {
        "required": ["read_status"],
        "properties": {
          "read_status": {
            "const": "ok"
          }
        }
      },
      "then": {
        "properties": {
          "counters": true,
          "error_code": false
        },
        "required": ["counters"]
      },
      "else": {
        "properties": {
          "error_code": true,
          "counters": false
        },
        "required": ["error_code"]
      }
    }
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_type": {
      "const": "queue_observation"
    },
    "execution_manifest_sha256": {
      "$ref": "_defs.schema.json#/$defs/sha256"
    },
    "trial_id": {
      "$ref": "_defs.schema.json#/$defs/uuid4"
    },
    "trial_manifest_sha256": {
      "$ref": "_defs.schema.json#/$defs/sha256"
    },
    "queue_role": {
      "enum": ["source", "dlq"]
    },
    "queue_name": {
      "type": "string",
      "minLength": 1
    },
    "observed_at": {
      "$ref": "_defs.schema.json#/$defs/utc_millis"
    },
    "read_status": {
      "enum": ["ok", "unavailable"]
    },
    "counters": {
      "$ref": "#/$defs/queue_counters"
    },
    "error_code": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "execution_manifest_sha256",
    "trial_id",
    "trial_manifest_sha256",
    "queue_role",
    "queue_name",
    "observed_at",
    "read_status"
  ],
  "unevaluatedProperties": false
}
