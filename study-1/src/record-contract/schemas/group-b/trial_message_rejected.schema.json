{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rua.serverless-under-constraints.invalid/schemas/trial_message_rejected.schema.json",
  "title": "trial_message_rejected (catalogue group B, row 20)",
  "description": "Caller journal: the consumer rejected a delivered trial message against the trial registry and called no provider (BR-RUA-036, AC-RUA-019, D-28). Carries the reason, the offending and expected values when known, and the exact body digest.",
  "type": "object",
  "allOf": [
    {
      "$ref": "_defs.schema.json#/$defs/event_envelope"
    }
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_type": {
      "const": "trial_message_rejected"
    },
    "event_id": true,
    "run_id": true,
    "variant_validation_id": true,
    "transport_probe_id": true,
    "execution_manifest_sha256": true,
    "trial_id": true,
    "trial_manifest_sha256": true,
    "occurred_at": true,
    "source_instance_id": true,
    "source_sequence": true,
    "causation_event_ids": true,
    "source": {
      "enum": ["conventional_caller", "durable_caller"]
    },
    "message_id": {
      "type": "string",
      "minLength": 1
    },
    "message_body_sha256": {
      "$ref": "_defs.schema.json#/$defs/sha256"
    },
    "reason": {
      "enum": [
        "SCHEMA_INVALID",
        "CORRELATION_MISSING",
        "EXECUTION_IDENTITY_MISMATCH",
        "TRIAL_MANIFEST_DIGEST_MISMATCH",
        "NO_ACTIVE_TRIAL"
      ]
    },
    "detail": {
      "type": "string",
      "minLength": 1
    },
    "offending_value": {
      "type": "string"
    },
    "expected_value": {
      "type": "string"
    },
    "refund_request_id": {
      "$ref": "_defs.schema.json#/$defs/nonempty_trimmed"
    },
    "payment_id": {
      "$ref": "_defs.schema.json#/$defs/nonempty_trimmed"
    }
  },
  "required": ["schema_version", "record_type", "source", "message_id", "message_body_sha256", "reason", "detail"],
  "additionalProperties": false
}
