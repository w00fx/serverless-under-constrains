{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rua.serverless-under-constraints.invalid/schemas/pre_cleanup_snapshot.schema.json",
  "title": "pre_cleanup_snapshot (catalogue group B, row 64)",
  "description": "cleanup/pre-cleanup-snapshot.json: the operational state before cleanup mutates anything (BR-RUA-048 step 4): treatment states, provider activity, Durable executions and queue counters, best effort, with every failed read recorded.",
  "type": "object",
  "$defs": {
    "queue_counters": {
      "type": "object",
      "properties": {
        "visible": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "in_flight": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "delayed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["visible", "in_flight", "delayed"],
      "additionalProperties": false
    },
    "treatment_read": {
      "type": "object",
      "properties": {
        "partition_key": {
          "type": "string",
          "minLength": 1
        },
        "read_status": {
          "enum": ["ok", "absent", "unavailable"]
        },
        "state": {
          "enum": [
            "ARMED",
            "COMMITTED_WAITING",
            "TIMEOUT_SIGNALLED",
            "TIMEOUT_OBSERVED",
            "RESPONSE_RELEASED",
            "SAFETY_RELEASED"
          ]
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": ["partition_key", "read_status"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": ["read_status"],
            "properties": {
              "read_status": {
                "const": "ok"
              }
            }
          },
          "then": {
            "properties": {
              "state": true,
              "version": true
            },
            "required": ["state", "version"]
          },
          "else": {
            "properties": {
              "state": false,
              "version": false
            }
          }
        }
      ]
    },
    "provider_activity": {
      "type": "object",
      "properties": {
        "partition_key": {
          "type": "string",
          "minLength": 1
        },
        "active_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "held_barriers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "pending_releases": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["partition_key", "active_calls", "held_barriers", "pending_releases"],
      "additionalProperties": false
    },
    "durable_execution_status": {
      "type": "object",
      "properties": {
        "durable_execution_arn": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["RUNNING", "SUCCEEDED", "FAILED", "TIMED_OUT", "STOPPED"]
        }
      },
      "required": ["durable_execution_arn", "status"],
      "additionalProperties": false
    },
    "queue_read": {
      "type": "object",
      "properties": {
        "queue_name": {
          "type": "string",
          "minLength": 1
        },
        "read_status": {
          "enum": ["ok", "unavailable"]
        },
        "counters": {
          "$ref": "#/$defs/queue_counters"
        }
      },
      "required": ["queue_name", "read_status"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": ["read_status"],
            "properties": {
              "read_status": {
                "const": "ok"
              }
            }
          },
          "then": {
            "properties": {
              "counters": true
            },
            "required": ["counters"]
          },
          "else": {
            "properties": {
              "counters": false
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "$ref": "_defs.schema.json#/$defs/execution_identity"
    }
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_type": {
      "const": "pre_cleanup_snapshot"
    },
    "execution_manifest_sha256": {
      "$ref": "_defs.schema.json#/$defs/sha256"
    },
    "trial_id": false,
    "trial_manifest_sha256": false,
    "captured_at": {
      "$ref": "_defs.schema.json#/$defs/utc_millis"
    },
    "cleanup_mode": {
      "enum": ["NORMAL", "EMERGENCY"]
    },
    "treatment_states": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/treatment_read"
      }
    },
    "provider_activity": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/provider_activity"
      }
    },
    "durable_executions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/durable_execution_status"
      }
    },
    "queues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/queue_read"
      }
    },
    "failures": {
      "$ref": "_defs.schema.json#/$defs/structured_reasons"
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "execution_manifest_sha256",
    "captured_at",
    "cleanup_mode",
    "treatment_states",
    "provider_activity",
    "durable_executions",
    "queues",
    "failures"
  ],
  "unevaluatedProperties": false
}
