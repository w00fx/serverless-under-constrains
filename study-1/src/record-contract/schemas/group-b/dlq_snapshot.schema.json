{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rua.serverless-under-constraints.invalid/schemas/dlq_snapshot.schema.json",
  "title": "dlq_snapshot (catalogue group B, row 59)",
  "description": "Conditional trials/<t>/queues/dlq-snapshot.json: the dead-letter messages received without deletion, each with its exact body and SQS attributes, captured before cleanup deletes them (BR-RUA-032, BR-RUA-037, BR-RUA-048 step 7).",
  "type": "object",
  "$defs": {
    "dlq_message": {
      "type": "object",
      "properties": {
        "message_id": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "string"
        },
        "body_sha256": {
          "$ref": "_defs.schema.json#/$defs/sha256"
        },
        "md5_of_body": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "approximate_receive_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "approximate_first_receive_timestamp": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "sent_timestamp": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "message_group_id": {
          "type": "string",
          "minLength": 1
        },
        "message_deduplication_id": {
          "type": "string",
          "minLength": 1
        },
        "sequence_number": {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      },
      "required": [
        "message_id",
        "body",
        "body_sha256",
        "md5_of_body",
        "approximate_receive_count",
        "approximate_first_receive_timestamp",
        "sent_timestamp",
        "message_group_id",
        "message_deduplication_id",
        "sequence_number"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "$ref": "_defs.schema.json#/$defs/execution_identity"
    }
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_type": {
      "const": "dlq_snapshot"
    },
    "execution_manifest_sha256": {
      "$ref": "_defs.schema.json#/$defs/sha256"
    },
    "trial_id": {
      "$ref": "_defs.schema.json#/$defs/uuid4"
    },
    "trial_manifest_sha256": {
      "$ref": "_defs.schema.json#/$defs/sha256"
    },
    "queue_name": {
      "type": "string",
      "minLength": 1
    },
    "captured_at": {
      "$ref": "_defs.schema.json#/$defs/utc_millis"
    },
    "receive_complete": {
      "type": "boolean"
    },
    "messages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dlq_message"
      }
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "execution_manifest_sha256",
    "trial_id",
    "trial_manifest_sha256",
    "queue_name",
    "captured_at",
    "receive_complete",
    "messages"
  ],
  "unevaluatedProperties": false
}
