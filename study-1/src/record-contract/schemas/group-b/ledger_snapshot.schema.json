{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rua.serverless-under-constraints.invalid/schemas/ledger_snapshot.schema.json",
  "title": "ledger_snapshot (catalogue group B, row 60)",
  "description": "trials/<t>/ledger/ledger-snapshot.json: the independent, strongly consistent, paginated read of the trial ledger partition, never truncated (BR-RUA-005, BR-RUA-032, BR-RUA-034, BR-RUA-009). writer and consistent_read are declared rather than fixed so G1 can judge a snapshot that was not taken by the collector or not consistently. Duplicate transaction ids stay schema-valid so ingestion can classify them.",
  "type": "object",
  "$defs": {
    "ledger_page": {
      "type": "object",
      "properties": {
        "page_number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "item_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "start_cursor": {
          "type": "string",
          "minLength": 1
        },
        "next_cursor": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["page_number", "item_count"],
      "additionalProperties": false
    },
    "ledger_transaction": {
      "type": "object",
      "properties": {
        "provider_transaction_id": {
          "$ref": "_defs.schema.json#/$defs/uuid4"
        },
        "provider_commit_id": {
          "$ref": "_defs.schema.json#/$defs/uuid4"
        },
        "provider_call_id": {
          "$ref": "_defs.schema.json#/$defs/uuid4"
        },
        "attempt_id": {
          "$ref": "_defs.schema.json#/$defs/uuid4"
        },
        "provider_request_id": {
          "$ref": "_defs.schema.json#/$defs/uuid4"
        },
        "refund_request_id": {
          "$ref": "_defs.schema.json#/$defs/nonempty_trimmed"
        },
        "payment_id": {
          "$ref": "_defs.schema.json#/$defs/nonempty_trimmed"
        },
        "amount_minor": {
          "$ref": "_defs.schema.json#/$defs/amount_minor"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "status": {
          "enum": ["SUCCEEDED"]
        },
        "commit_requested_at": {
          "$ref": "_defs.schema.json#/$defs/utc_millis"
        }
      },
      "required": [
        "provider_transaction_id",
        "provider_commit_id",
        "provider_call_id",
        "attempt_id",
        "provider_request_id",
        "refund_request_id",
        "payment_id",
        "amount_minor",
        "currency",
        "status",
        "commit_requested_at"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "$ref": "_defs.schema.json#/$defs/execution_identity"
    }
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_type": {
      "const": "ledger_snapshot"
    },
    "run_id": true,
    "variant_validation_id": true,
    "transport_probe_id": true,
    "execution_manifest_sha256": {
      "$ref": "_defs.schema.json#/$defs/sha256"
    },
    "trial_id": {
      "$ref": "_defs.schema.json#/$defs/uuid4"
    },
    "trial_manifest_sha256": {
      "$ref": "_defs.schema.json#/$defs/sha256"
    },
    "writer": {
      "$ref": "_defs.schema.json#/$defs/event_source"
    },
    "partition_key": {
      "type": "string",
      "minLength": 1
    },
    "consistent_read": {
      "type": "boolean"
    },
    "captured_at": {
      "$ref": "_defs.schema.json#/$defs/utc_millis"
    },
    "complete": {
      "type": "boolean"
    },
    "pages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ledger_page"
      }
    },
    "transactions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ledger_transaction"
      }
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "execution_manifest_sha256",
    "writer",
    "partition_key",
    "consistent_read",
    "captured_at",
    "complete",
    "pages",
    "transactions"
  ],
  "dependentRequired": {
    "trial_id": ["trial_manifest_sha256"],
    "trial_manifest_sha256": ["trial_id"]
  },
  "additionalProperties": false
}
