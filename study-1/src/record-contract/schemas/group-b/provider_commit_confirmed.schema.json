    },
    "provider_commit_id": {
      "$ref": "_defs.schema.json#/$defs/uuid4"
    },
    "provider_transaction_id": {
      "$ref": "_defs.schema.json#/$defs/uuid4"
    },
    "provider_call_id": {
      "$ref": "_defs.schema.json#/$defs/uuid4"
    },
    "committed_at": {
      "$ref": "_defs.schema.json#/$defs/utc_millis"
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "source",
    "provider_commit_id",
    "provider_transaction_id",
    "provider_call_id",
    "committed_at"
