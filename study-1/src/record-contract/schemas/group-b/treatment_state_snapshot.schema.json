{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rua.serverless-under-constraints.invalid/schemas/treatment_state_snapshot.schema.json",
  "title": "treatment_state_snapshot (catalogue group B, row 61)",
  "description": "state/treatment-state-snapshot.json: a strongly consistent read of the control treatment item after settlement (BR-RUA-025, BR-RUA-032). A CONTROL trial has no item; when present, the item carries its state, version, commit triple and signal identities as far as they exist.",
  "type": "object",
  "$defs": {
    "treatment_item": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "ARMED",
            "COMMITTED_WAITING",
            "TIMEOUT_SIGNALLED",
            "TIMEOUT_OBSERVED",
            "RESPONSE_RELEASED",
            "SAFETY_RELEASED"
          ]
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "targeted_attempt_id": {
          "$ref": "_defs.schema.json#/$defs/uuid4"
        },
        "provider_request_id": {
          "$ref": "_defs.schema.json#/$defs/uuid4"
        },
        "provider_call_id": {
          "$ref": "_defs.schema.json#/$defs/uuid4"
        },
        "provider_commit_id": {
          "$ref": "_defs.schema.json#/$defs/uuid4"
        },
        "provider_transaction_id": {
          "$ref": "_defs.schema.json#/$defs/uuid4"
        },
        "commit_event_id": {
          "$ref": "_defs.schema.json#/$defs/uuid4"
        },
        "signal_event_id": {
          "$ref": "_defs.schema.json#/$defs/uuid4"
        },
        "signal_caller_event_id": {
          "$ref": "_defs.schema.json#/$defs/uuid4"
        },
        "observed_event_id": {
          "$ref": "_defs.schema.json#/$defs/uuid4"
        },
        "release_event_id": {
          "$ref": "_defs.schema.json#/$defs/uuid4"
        },
        "safety_release_cause": {
          "enum": ["SAFETY_DEADLINE", "CLEANUP_REQUEST"]
        }
      },
      "required": ["state", "version"],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "$ref": "_defs.schema.json#/$defs/execution_identity"
    },
    {
      "if": {
        "required": ["item_present"],
        "properties": {
          "item_present": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "treatment": true
        },
        "required": ["treatment"]
      },
      "else": {
        "properties": {
          "treatment": false
        }
      }
    }
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_type": {
      "const": "treatment_state_snapshot"
    },
    "execution_manifest_sha256": {
      "$ref": "_defs.schema.json#/$defs/sha256"
    },
    "trial_id": {
      "$ref": "_defs.schema.json#/$defs/uuid4"
    },
    "trial_manifest_sha256": {
      "$ref": "_defs.schema.json#/$defs/sha256"
    },
    "partition_key": {
      "type": "string",
      "minLength": 1
    },
    "captured_at": {
      "$ref": "_defs.schema.json#/$defs/utc_millis"
    },
    "consistent_read": {
      "type": "boolean"
    },
    "item_present": {
      "type": "boolean"
    },
    "treatment": {
      "$ref": "#/$defs/treatment_item"
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "execution_manifest_sha256",
    "partition_key",
    "captured_at",
    "consistent_read",
    "item_present"
  ],
  "dependentRequired": {
    "trial_id": ["trial_manifest_sha256"],
    "trial_manifest_sha256": ["trial_id"]
  },
  "unevaluatedProperties": false
}
