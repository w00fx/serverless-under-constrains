{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rua.serverless-under-constraints.invalid/schemas/provider_call_received.schema.json",
  "title": "provider_call_received (catalogue group B, row 29)",
  "description": "Provider journal: every received call gets a fresh provider_call_id, rejected calls included (BR-RUA-018). The caller identifiers are copied verbatim when present as strings, so they are not shape-checked here; raw_request_sha256 digests the exact request bytes.",
  "type": "object",
  "allOf": [
    {
      "$ref": "_defs.schema.json#/$defs/event_envelope"
    }
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_type": {
      "const": "provider_call_received"
    },
    "source": {
      "enum": ["refund_provider"]
    },
    "provider_call_id": {
      "$ref": "_defs.schema.json#/$defs/uuid4"
    },
    "raw_request_sha256": {
      "$ref": "_defs.schema.json#/$defs/sha256"
    },
    "caller_id": {
      "type": "string"
    },
    "attempt_id": {
      "type": "string"
    },
    "provider_request_id": {
      "type": "string"
    },
    "refund_request_id": {
      "type": "string"
    },
    "payment_id": {
      "type": "string"
    }
  },
  "required": ["schema_version", "record_type", "source", "provider_call_id", "raw_request_sha256"],
  "unevaluatedProperties": false
}
