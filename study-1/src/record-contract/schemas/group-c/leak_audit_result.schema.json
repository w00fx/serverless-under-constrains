{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rua.serverless-under-constraints.invalid/schemas/leak_audit_result.schema.json",
  "title": "leak_audit_result (catalogue group C, row 76)",
  "description": "cleanup/leak-audit-result.json (BR-RUA-051, BR-RUA-052; design §6.3, §8.18, §9.14): every audit pass over the discovery surfaces, leaks with their capability_class (D-30) and ambiguous resources. clean needs two complete passes, every query successful, nothing observed, no leak or ambiguous resource, and at least 120000 ms of stable absence; leaks_detected needs a leak with every query successful and nothing ambiguous; inconclusive needs a failed query, an ambiguous resource or fewer than two passes.",
  "type": "object",
  "$defs": {
    "surface_observation": {
      "type": "object",
      "properties": {
        "surface": {
          "enum": [
            "tag_index",
            "stack",
            "stack_resources",
            "functions",
            "event_source_mappings",
            "durable_executions",
            "queues",
            "tables",
            "log_groups",
            "roles"
          ]
        },
        "query_ok": {
          "type": "boolean"
        },
        "observed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": ["surface", "query_ok", "observed"],
      "additionalProperties": false
    },
    "audit_pass": {
      "type": "object",
      "properties": {
        "started_at": {
          "$ref": "_defs.schema.json#/$defs/utc_millis"
        },
        "completed_at": {
          "$ref": "_defs.schema.json#/$defs/utc_millis"
        },
        "surfaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/surface_observation"
          },
          "minItems": 1
        }
      },
      "required": ["started_at", "completed_at", "surfaces"],
      "additionalProperties": false
    },
    "leak": {
      "type": "object",
      "properties": {
        "resource_type": {
          "type": "string",
          "minLength": 1
        },
        "identifier": {
          "type": "string",
          "minLength": 1
        },
        "surface": {
          "enum": [
            "tag_index",
            "stack",
            "stack_resources",
            "functions",
            "event_source_mappings",
            "durable_executions",
            "queues",
            "tables",
            "log_groups",
            "roles"
          ]
        },
        "capability_class": {
          "enum": ["processing_capable", "storage_only", "identity", "unknown"]
        },
        "ownership_basis": {
          "enum": ["recorded_stack", "resource_manifest_and_tags", "tags_name_type_created_after_freeze"]
        }
      },
      "required": ["resource_type", "identifier", "surface", "capability_class", "ownership_basis"],
      "additionalProperties": false
    },
    "ambiguous_resource": {
      "type": "object",
      "properties": {
        "resource_type": {
          "type": "string",
          "minLength": 1
        },
        "identifier": {
          "type": "string",
          "minLength": 1
        },
        "surface": {
          "enum": [
            "tag_index",
            "stack",
            "stack_resources",
            "functions",
            "event_source_mappings",
            "durable_executions",
            "queues",
            "tables",
            "log_groups",
            "roles"
          ]
        },
        "reasons": {
          "allOf": [
            {
              "$ref": "_defs.schema.json#/$defs/structured_reasons"
            },
            {
              "type": "array",
              "minItems": 1
            }
          ]
        }
      },
      "required": ["resource_type", "identifier", "surface", "reasons"],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "$ref": "_defs.schema.json#/$defs/execution_identity"
    },
    {
      "if": {
        "properties": {
          "leak_audit_status": {
            "const": "clean"
          }
        },
        "required": ["leak_audit_status"]
      },
      "then": {
        "properties": {
          "passes": {
            "allOf": [
              {
                "type": "array",
                "minItems": 2
              },
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "surfaces": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "query_ok": {
                            "const": true
                          },
                          "observed": {
                            "type": "array",
                            "maxItems": 0
                          }
                        }
                      }
                    }
                  }
                }
              }
            ]
          },
          "leaks": {
            "type": "array",
            "maxItems": 0
          },
          "ambiguous": {
            "type": "array",
            "maxItems": 0
          },
          "stable_absence_interval_ms": {
            "type": "integer",
            "minimum": 120000
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "leak_audit_status": {
            "const": "leaks_detected"
          }
        },
        "required": ["leak_audit_status"]
      },
      "then": {
        "properties": {
          "passes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "surfaces": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "query_ok": {
                        "const": true
                      }
                    }
                  }
                }
              }
            }
          },
          "leaks": {
            "type": "array",
            "minItems": 1
          },
          "ambiguous": {
            "type": "array",
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "leak_audit_status": {
            "const": "inconclusive"
          }
        },
        "required": ["leak_audit_status"]
      },
      "then": {
        "anyOf": [
          {
            "properties": {
              "ambiguous": {
                "type": "array",
                "minItems": 1
              }
            }
          },
          {
            "properties": {
              "passes": {
                "type": "array",
                "contains": {
                  "type": "object",
                  "properties": {
                    "surfaces": {
                      "type": "array",
                      "contains": {
                        "type": "object",
                        "properties": {
                          "query_ok": {
                            "const": false
                          }
                        },
                        "required": ["query_ok"]
                      }
                    }
                  },
                  "required": ["surfaces"]
                }
              }
            }
          },
          {
            "properties": {
              "passes": {
                "type": "array",
                "maxItems": 1
              }
            }
          }
        ]
      }
    }
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_type": {
      "const": "leak_audit_result"
    },
    "run_id": {
      "$ref": "_defs.schema.json#/$defs/uuid4"
    },
    "variant_validation_id": {
      "$ref": "_defs.schema.json#/$defs/uuid4"
    },
    "transport_probe_id": {
      "$ref": "_defs.schema.json#/$defs/uuid4"
    },
    "trial_id": false,
    "trial_manifest_sha256": false,
    "execution_manifest_sha256": {
      "$ref": "_defs.schema.json#/$defs/sha256"
    },
    "leak_audit_status": {
      "enum": ["clean", "leaks_detected", "inconclusive"]
    },
    "passes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/audit_pass"
      }
    },
    "leaks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/leak"
      }
    },
    "ambiguous": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ambiguous_resource"
      }
    },
    "stable_absence_interval_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "audited_at": {
      "$ref": "_defs.schema.json#/$defs/utc_millis"
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "execution_manifest_sha256",
    "leak_audit_status",
    "passes",
    "leaks",
    "ambiguous",
    "stable_absence_interval_ms",
    "audited_at"
  ],
  "unevaluatedProperties": false
}
