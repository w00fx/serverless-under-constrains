{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rua.serverless-under-constraints.invalid/schemas/late_evidence_record.schema.json",
  "title": "late_evidence_record (catalogue group C, row 77)",
  "description": "One line of late-evidence/late-evidence-stream.jsonl (BR-RUA-043): a record observed after the final freeze, where it was observed, and whether it correlates with a frozen trial or the probe. The late record is carried as parsed JSON and validated against its own schema by ingestion; frozen evidence is never modified. A trial pair names the correlated trial, so it implies correlated = true; a probe stream names no trial.",
  "type": "object",
  "allOf": [
    {
      "$ref": "_defs.schema.json#/$defs/execution_identity"
    },
    {
      "if": {
        "properties": {
          "transport_probe_id": true
        },
        "required": ["transport_probe_id"]
      },
      "then": {
        "properties": {
          "trial_id": false,
          "trial_manifest_sha256": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "trial_id": true
        },
        "required": ["trial_id"]
      },
      "then": {
        "properties": {
          "correlated": {
            "const": true
          }
        }
      }
    }
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_type": {
      "const": "late_evidence_record"
    },
    "run_id": {
      "$ref": "_defs.schema.json#/$defs/uuid4"
    },
    "variant_validation_id": {
      "$ref": "_defs.schema.json#/$defs/uuid4"
    },
    "transport_probe_id": {
      "$ref": "_defs.schema.json#/$defs/uuid4"
    },
    "execution_manifest_sha256": {
      "$ref": "_defs.schema.json#/$defs/sha256"
    },
    "trial_id": {
      "$ref": "_defs.schema.json#/$defs/uuid4"
    },
    "trial_manifest_sha256": {
      "$ref": "_defs.schema.json#/$defs/sha256"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "captured_at": {
      "$ref": "_defs.schema.json#/$defs/utc_millis"
    },
    "late_source": {
      "enum": [
        "CALLER_JOURNAL",
        "PROVIDER_JOURNAL",
        "CONTROLLER_JOURNAL",
        "RUNNER_JOURNAL",
        "LEDGER",
        "SOURCE_QUEUE",
        "DLQ",
        "DURABLE_EXECUTION_METADATA"
      ]
    },
    "correlated": {
      "type": "boolean"
    },
    "late_record_type": {
      "$ref": "_defs.schema.json#/$defs/record_type_name"
    },
    "late_record": {
      "type": "object",
      "properties": {
        "schema_version": true,
        "record_type": true
      },
      "required": ["schema_version", "record_type"]
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "execution_manifest_sha256",
    "sequence",
    "captured_at",
    "late_source",
    "correlated",
    "late_record_type",
    "late_record"
  ],
  "dependentRequired": {
    "trial_id": ["trial_manifest_sha256"],
    "trial_manifest_sha256": ["trial_id"]
  },
  "unevaluatedProperties": false
}
