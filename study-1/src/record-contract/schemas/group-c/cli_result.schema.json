{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rua.serverless-under-constraints.invalid/schemas/cli_result.schema.json",
  "title": "cli_result (catalogue group C, row 88)",
  "description": "The single canonical-JSON line the operator CLI prints on stdout; never evidence (OQ-RUA-003, D-14; design §11). Each outcome has exactly one exit code; every outcome other than completed states its reasons; at most one execution identity is present.",
  "type": "object",
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "completed"
          }
        },
        "required": ["outcome"]
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "usage_error"
          }
        },
        "required": ["outcome"]
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 2
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "admission_rejected"
          }
        },
        "required": ["outcome"]
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 3
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "execution_incomplete"
          }
        },
        "required": ["outcome"]
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 4
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "verification_failed"
          }
        },
        "required": ["outcome"]
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 5
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "operational_closure_not_clean"
          }
        },
        "required": ["outcome"]
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 6
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "lease_problem"
          }
        },
        "required": ["outcome"]
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 7
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "internal_failure"
          }
        },
        "required": ["outcome"]
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 10
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "not": {
              "const": "completed"
            }
          }
        },
        "required": ["outcome"]
      },
      "then": {
        "properties": {
          "reasons": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    {
      "not": {
        "anyOf": [
          {
            "properties": {
              "run_id": true,
              "transport_probe_id": true
            },
            "required": ["run_id", "transport_probe_id"]
          },
          {
            "properties": {
              "run_id": true,
              "variant_validation_id": true
            },
            "required": ["run_id", "variant_validation_id"]
          },
          {
            "properties": {
              "transport_probe_id": true,
              "variant_validation_id": true
            },
            "required": ["transport_probe_id", "variant_validation_id"]
          }
        ]
      }
    }
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_type": {
      "const": "cli_result"
    },
    "command": {
      "type": "string",
      "pattern": "^[a-z][a-z-]*( [a-z][a-z-]*)*$"
    },
    "outcome": {
      "enum": [
        "completed",
        "usage_error",
        "admission_rejected",
        "execution_incomplete",
        "verification_failed",
        "operational_closure_not_clean",
        "lease_problem",
        "internal_failure"
      ]
    },
    "exit_code": {
      "enum": [0, 2, 3, 4, 5, 6, 7, 10]
    },
    "run_id": {
      "$ref": "_defs.schema.json#/$defs/uuid4"
    },
    "variant_validation_id": {
      "$ref": "_defs.schema.json#/$defs/uuid4"
    },
    "transport_probe_id": {
      "$ref": "_defs.schema.json#/$defs/uuid4"
    },
    "written_paths": {
      "type": "array",
      "items": {
        "$ref": "_defs.schema.json#/$defs/package_relative_path"
      },
      "uniqueItems": true
    },
    "result_record": {
      "type": "object",
      "properties": {
        "schema_version": true,
        "record_type": true
      },
      "required": ["schema_version", "record_type"]
    },
    "reasons": {
      "$ref": "_defs.schema.json#/$defs/structured_reasons"
    },
    "completed_at": {
      "$ref": "_defs.schema.json#/$defs/utc_millis"
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "command",
    "outcome",
    "exit_code",
    "written_paths",
    "reasons",
    "completed_at"
  ],
  "unevaluatedProperties": false
}
