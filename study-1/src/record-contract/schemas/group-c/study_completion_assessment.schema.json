{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rua.serverless-under-constraints.invalid/schemas/study_completion_assessment.schema.json",
  "title": "study_completion_assessment (catalogue group C, row 83)",
  "description": "evidence/verifications/ (BR-RUA-054; design §8.14): study completion over the ORIGINAL run package, never frozen inside it. complete exactly with comparison and package eligible, cleanup succeeded, audit clean, lease released, run COMPLETED, every further condition holding and no reason. Operational-recovery amendments never complete a study (AC-RUA-038).",
  "type": "object",
  "$defs": {
    "completion_check": {
      "type": "object",
      "properties": {
        "check_id": {
          "enum": [
            "FOUR_ORACLE_RESULTS",
            "EQUALITY_EVALUATED",
            "EVIDENCE_INTEGRITY_VERIFIED",
            "NO_CONTRADICTORY_AMENDMENT",
            "NO_KNOWN_SAFETY_BREACH",
            "NO_REMAINING_OWNED_RESOURCE",
            "CLEAN_SOURCE_AND_MATCHING_QUALIFICATION"
          ]
        },
        "holds": {
          "type": "boolean"
        }
      },
      "required": ["check_id", "holds"],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "study_completion": {
            "const": "complete"
          }
        },
        "required": ["study_completion"]
      },
      "then": {
        "properties": {
          "comparison_eligibility": {
            "const": "eligible"
          },
          "package_eligibility": {
            "const": "eligible"
          },
          "cleanup_status": {
            "const": "succeeded"
          },
          "leak_audit_status": {
            "const": "clean"
          },
          "lease_status": {
            "const": "released"
          },
          "run_terminal_reason": {
            "const": "COMPLETED"
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "holds": {
                  "const": true
                }
              }
            }
          },
          "incompletion_reasons": {
            "type": "array",
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "incompletion_reasons": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_type": {
      "const": "study_completion_assessment"
    },
    "run_id": {
      "$ref": "_defs.schema.json#/$defs/uuid4"
    },
    "variant_validation_id": false,
    "transport_probe_id": false,
    "original_package_index_sha256": {
      "$ref": "_defs.schema.json#/$defs/sha256"
    },
    "study_completion": {
      "enum": ["complete", "incomplete"]
    },
    "comparison_eligibility": {
      "enum": ["eligible", "ineligible"]
    },
    "package_eligibility": {
      "enum": ["eligible", "ineligible"]
    },
    "cleanup_status": {
      "enum": ["not_started", "running", "succeeded", "partial", "failed"]
    },
    "leak_audit_status": {
      "enum": ["clean", "leaks_detected", "inconclusive"]
    },
    "lease_status": {
      "enum": ["released", "recovery_required", "unverified"]
    },
    "run_terminal_reason": {
      "enum": [
        "COMPLETED",
        "LEASE_ACQUISITION_FAILED",
        "LEASE_LOST",
        "PROVISIONING_FAILED",
        "TRIAL_INCOMPLETE",
        "SAFETY_DEADLINE",
        "OPERATOR_ABORT",
        "INTERRUPTED",
        "CLEANUP_INCOMPLETE",
        "LEAK_AUDIT_NOT_CLEAN",
        "EVIDENCE_FINALIZATION_FAILED"
      ]
    },
    "checks": {
      "type": "array",
      "prefixItems": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/completion_check"
            },
            {
              "type": "object",
              "properties": {
                "check_id": {
                  "const": "FOUR_ORACLE_RESULTS"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/completion_check"
            },
            {
              "type": "object",
              "properties": {
                "check_id": {
                  "const": "EQUALITY_EVALUATED"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/completion_check"
            },
            {
              "type": "object",
              "properties": {
                "check_id": {
                  "const": "EVIDENCE_INTEGRITY_VERIFIED"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/completion_check"
            },
            {
              "type": "object",
              "properties": {
                "check_id": {
                  "const": "NO_CONTRADICTORY_AMENDMENT"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/completion_check"
            },
            {
              "type": "object",
              "properties": {
                "check_id": {
                  "const": "NO_KNOWN_SAFETY_BREACH"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/completion_check"
            },
            {
              "type": "object",
              "properties": {
                "check_id": {
                  "const": "NO_REMAINING_OWNED_RESOURCE"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/completion_check"
            },
            {
              "type": "object",
              "properties": {
                "check_id": {
                  "const": "CLEAN_SOURCE_AND_MATCHING_QUALIFICATION"
                }
              }
            }
          ]
        }
      ],
      "minItems": 7,
      "maxItems": 7,
      "items": false
    },
    "incompletion_reasons": {
      "$ref": "_defs.schema.json#/$defs/structured_reasons"
    },
    "evidence_refs": {
      "$ref": "_defs.schema.json#/$defs/evidence_refs"
    },
    "assessed_at": {
      "$ref": "_defs.schema.json#/$defs/utc_millis"
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "run_id",
    "original_package_index_sha256",
    "study_completion",
    "comparison_eligibility",
    "package_eligibility",
    "cleanup_status",
    "leak_audit_status",
    "lease_status",
    "run_terminal_reason",
    "checks",
    "incompletion_reasons",
    "evidence_refs",
    "assessed_at"
  ],
  "unevaluatedProperties": false
}
