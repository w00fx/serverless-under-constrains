{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rua.serverless-under-constraints.invalid/schemas/run_summary.schema.json",
  "title": "run_summary (catalogue group C, row 72)",
  "description": "summary/run-summary.json (CTR-RUA-002; design §6.3): exactly four trial results in the declared BR-RUA-019 order, each with its execution status and either an oracle-result reference or its incompletion reasons, never filtered, reordered or annotated (AC-RUA-012). It records the operational statuses separately and has no winner, aggregate, ranking or statistic.",
  "type": "object",
  "$defs": {
    "artifact_ref": {
      "type": "object",
      "properties": {
        "artifact_path": {
          "$ref": "_defs.schema.json#/$defs/package_relative_path"
        },
        "artifact_sha256": {
          "$ref": "_defs.schema.json#/$defs/sha256"
        }
      },
      "required": ["artifact_path", "artifact_sha256"],
      "additionalProperties": false
    },
    "trial_result": {
      "type": "object",
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "trial_id": {
          "$ref": "_defs.schema.json#/$defs/uuid4"
        },
        "variant_id": {
          "enum": ["conventional", "durable"]
        },
        "scenario": {
          "enum": ["CONTROL", "COMMIT_THEN_TIMEOUT"]
        },
        "execution_status": {
          "enum": ["completed", "incomplete", "not_started"]
        },
        "oracle_result_ref": {
          "$ref": "#/$defs/artifact_ref"
        },
        "preservation_verdict": {
          "enum": ["pass", "fail", "indeterminate"]
        },
        "correct_completion": {
          "enum": [true, false, null]
        },
        "incompletion_reasons": {
          "$ref": "_defs.schema.json#/$defs/structured_reasons"
        }
      },
      "required": ["sequence", "trial_id", "variant_id", "scenario", "execution_status", "incompletion_reasons"],
      "dependentRequired": {
        "oracle_result_ref": ["preservation_verdict", "correct_completion"],
        "preservation_verdict": ["oracle_result_ref"],
        "correct_completion": ["oracle_result_ref"]
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "execution_status": {
                "const": "completed"
              }
            },
            "required": ["execution_status"]
          },
          "then": {
            "properties": {
              "oracle_result_ref": true
            },
            "required": ["oracle_result_ref"]
          }
        },
        {
          "if": {
            "not": {
              "properties": {
                "oracle_result_ref": true
              },
              "required": ["oracle_result_ref"]
            }
          },
          "then": {
            "properties": {
              "incompletion_reasons": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "preservation_verdict": {
                "const": "indeterminate"
              }
            },
            "required": ["preservation_verdict"]
          },
          "then": {
            "properties": {
              "correct_completion": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "preservation_verdict": {
                "const": "fail"
              }
            },
            "required": ["preservation_verdict"]
          },
          "then": {
            "properties": {
              "correct_completion": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "preservation_verdict": {
                "const": "pass"
              }
            },
            "required": ["preservation_verdict"]
          },
          "then": {
            "properties": {
              "correct_completion": {
                "enum": [true, false]
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "comparison_eligibility": {
            "const": "eligible"
          }
        },
        "required": ["comparison_eligibility"]
      },
      "then": {
        "properties": {
          "comparison_ineligibility_reasons": {
            "type": "array",
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "comparison_eligibility": {
            "const": "ineligible"
          }
        },
        "required": ["comparison_eligibility"]
      },
      "then": {
        "properties": {
          "comparison_ineligibility_reasons": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_type": {
      "const": "run_summary"
    },
    "run_id": {
      "$ref": "_defs.schema.json#/$defs/uuid4"
    },
    "variant_validation_id": false,
    "transport_probe_id": false,
    "trial_id": false,
    "trial_manifest_sha256": false,
    "execution_manifest_sha256": {
      "$ref": "_defs.schema.json#/$defs/sha256"
    },
    "trial_results": {
      "type": "array",
      "prefixItems": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/trial_result"
            },
            {
              "type": "object",
              "properties": {
                "sequence": {
                  "const": 1
                },
                "scenario": {
                  "const": "CONTROL"
                },
                "variant_id": {
                  "const": "conventional"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/trial_result"
            },
            {
              "type": "object",
              "properties": {
                "sequence": {
                  "const": 2
                },
                "scenario": {
                  "const": "CONTROL"
                },
                "variant_id": {
                  "const": "durable"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/trial_result"
            },
            {
              "type": "object",
              "properties": {
                "sequence": {
                  "const": 3
                },
                "scenario": {
                  "const": "COMMIT_THEN_TIMEOUT"
                },
                "variant_id": {
                  "const": "conventional"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/trial_result"
            },
            {
              "type": "object",
              "properties": {
                "sequence": {
                  "const": 4
                },
                "scenario": {
                  "const": "COMMIT_THEN_TIMEOUT"
                },
                "variant_id": {
                  "const": "durable"
                }
              }
            }
          ]
        }
      ],
      "minItems": 4,
      "maxItems": 4,
      "items": false
    },
    "execution_status": {
      "enum": ["completed", "incomplete"]
    },
    "run_terminal_reason": {
      "enum": [
        "COMPLETED",
        "LEASE_ACQUISITION_FAILED",
        "LEASE_LOST",
        "PROVISIONING_FAILED",
        "TRIAL_INCOMPLETE",
        "SAFETY_DEADLINE",
        "OPERATOR_ABORT",
        "INTERRUPTED",
        "CLEANUP_INCOMPLETE",
        "LEAK_AUDIT_NOT_CLEAN",
        "EVIDENCE_FINALIZATION_FAILED"
      ]
    },
    "comparison_eligibility": {
      "enum": ["eligible", "ineligible"]
    },
    "comparison_ineligibility_reasons": {
      "$ref": "_defs.schema.json#/$defs/structured_reasons"
    },
    "cleanup_status": {
      "enum": ["not_started", "running", "succeeded", "partial", "failed"]
    },
    "leak_audit_status": {
      "enum": ["clean", "leaks_detected", "inconclusive"]
    },
    "lease_status": {
      "enum": ["released", "recovery_required", "unverified"]
    },
    "safety_status": {
      "enum": ["within_limits", "breached", "unverified"]
    },
    "evidence_integrity_status": {
      "enum": ["verified", "invalid", "unverified"]
    },
    "cleanup_result_ref": {
      "$ref": "#/$defs/artifact_ref"
    },
    "late_evidence_assessment_ref": {
      "$ref": "#/$defs/artifact_ref"
    },
    "comparison_assessment_ref": {
      "$ref": "#/$defs/artifact_ref"
    },
    "created_at": {
      "$ref": "_defs.schema.json#/$defs/utc_millis"
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "run_id",
    "execution_manifest_sha256",
    "trial_results",
    "execution_status",
    "run_terminal_reason",
    "comparison_eligibility",
    "comparison_ineligibility_reasons",
    "cleanup_status",
    "leak_audit_status",
    "lease_status",
    "safety_status",
    "evidence_integrity_status",
    "cleanup_result_ref",
    "late_evidence_assessment_ref",
    "comparison_assessment_ref",
    "created_at"
  ],
  "unevaluatedProperties": false
}
