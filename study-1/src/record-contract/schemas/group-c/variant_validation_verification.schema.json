{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rua.serverless-under-constraints.invalid/schemas/variant_validation_verification.schema.json",
  "title": "variant_validation_verification (catalogue group C, row 82)",
  "description": "evidence/verifications/ (CTR-RUA-004; design §6.3, §8.15): exactly the CTR-RUA-004 fields plus validation_validity. A conclusive effective status (verified or failed) needs an eligible package, a valid validation and effective cleanup succeeded, audit clean and lease released; an indeterminate one states its reasons. Without a selected amendment head no operational recovery can apply. The summary reference names its package-index digest because the verifier output lives outside the package (BR-RUA-035).",
  "type": "object",
  "allOf": [
    {
      "if": {
        "properties": {
          "effective_implementation_validation_status": {
            "enum": ["verified", "failed"]
          }
        },
        "required": ["effective_implementation_validation_status"]
      },
      "then": {
        "properties": {
          "package_eligibility": {
            "const": "eligible"
          },
          "validation_validity": {
            "const": "valid"
          },
          "effective_cleanup_status": {
            "const": "succeeded"
          },
          "effective_leak_audit_status": {
            "const": "clean"
          },
          "effective_lease_status": {
            "const": "released"
          }
        }
      },
      "else": {
        "properties": {
          "effective_status_reasons": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "selected_amendment_head_sha256": {
            "const": null
          }
        },
        "required": ["selected_amendment_head_sha256"]
      },
      "then": {
        "properties": {
          "operational_recovery_applied": {
            "const": false
          }
        }
      }
    }
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_type": {
      "const": "variant_validation_verification"
    },
    "variant_validation_id": {
      "$ref": "_defs.schema.json#/$defs/uuid4"
    },
    "run_id": false,
    "transport_probe_id": false,
    "validation_summary_ref": {
      "allOf": [
        {
          "$ref": "_defs.schema.json#/$defs/evidence_ref"
        },
        {
          "type": "object",
          "properties": {
            "package_index_sha256": true
          },
          "required": ["package_index_sha256"]
        }
      ]
    },
    "original_package_index_sha256": {
      "$ref": "_defs.schema.json#/$defs/sha256"
    },
    "selected_amendment_head_sha256": {
      "oneOf": [
        {
          "$ref": "_defs.schema.json#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "package_eligibility": {
      "enum": ["eligible", "ineligible"]
    },
    "declared_implementation_validation_status": {
      "enum": ["verified", "failed", "indeterminate"]
    },
    "effective_implementation_validation_status": {
      "enum": ["verified", "failed", "indeterminate"]
    },
    "effective_cleanup_status": {
      "enum": ["succeeded", "partial", "failed", "unverified"]
    },
    "effective_leak_audit_status": {
      "enum": ["clean", "leaks_detected", "inconclusive", "unverified"]
    },
    "effective_lease_status": {
      "enum": ["released", "recovery_required", "unverified"]
    },
    "operational_recovery_applied": {
      "type": "boolean"
    },
    "effective_status_reasons": {
      "$ref": "_defs.schema.json#/$defs/structured_reasons"
    },
    "evidence_refs": {
      "$ref": "_defs.schema.json#/$defs/evidence_refs"
    },
    "checked_at": {
      "$ref": "_defs.schema.json#/$defs/utc_millis"
    },
    "validation_validity": {
      "enum": ["valid", "invalid", "indeterminate"]
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "variant_validation_id",
    "validation_summary_ref",
    "original_package_index_sha256",
    "selected_amendment_head_sha256",
    "package_eligibility",
    "declared_implementation_validation_status",
    "effective_implementation_validation_status",
    "effective_cleanup_status",
    "effective_leak_audit_status",
    "effective_lease_status",
    "operational_recovery_applied",
    "effective_status_reasons",
    "evidence_refs",
    "checked_at",
    "validation_validity"
  ],
  "additionalProperties": false
}
