{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rua.serverless-under-constraints.invalid/schemas/attempt_projection.schema.json",
  "title": "attempt_projection (catalogue group C, row 66)",
  "description": "trials/<t>/derived/attempt-projection.json (a probe projection carries no trial identity): the derived per-attempt view of one trial, never fed back into a verdict (BR-RUA-037, BR-RUA-021, BR-RUA-022; design §8.9). Provider transaction ids are joined through the provider commit event, never through the caller; transactions reference the ledger snapshot and never copy it. Each attempt follows BR-RUA-021 (SUCCEEDED, REJECTED and TIMED_OUT imply DISPATCHED) and the BR-RUA-022 outcome classes: SUCCEEDED is SUCCESS, REJECTED is REJECTION, TIMED_OUT and a FAILED that is DISPATCHED or UNKNOWN are AMBIGUOUS, a FAILED proven NOT_DISPATCHED is PRE_DISPATCH_FAILURE, and a DISPATCHED attempt with no recorded outcome counts as AMBIGUOUS (design §8.5).",
  "type": "object",
  "$defs": {
    "invocation": {
      "type": "object",
      "properties": {
        "source": {
          "enum": ["conventional_caller", "durable_caller", "probe_caller"]
        },
        "source_instance_id": {
          "$ref": "_defs.schema.json#/$defs/uuid4"
        },
        "message_id": {
          "type": "string",
          "minLength": 1
        },
        "receive_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "durable_execution_arn": {
          "type": "string",
          "minLength": 1
        },
        "step_attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": ["source", "source_instance_id"],
      "additionalProperties": false
    },
    "late_settlement": {
      "type": "object",
      "properties": {
        "settlement_kind": {
          "enum": ["aborted", "resolved", "rejected"]
        },
        "observed_after_elapsed_ns": {
          "$ref": "_defs.schema.json#/$defs/monotonic_ns"
        }
      },
      "required": ["settlement_kind", "observed_after_elapsed_ns"],
      "additionalProperties": false
    },
    "attempt": {
      "type": "object",
      "properties": {
        "attempt_id": {
          "$ref": "_defs.schema.json#/$defs/uuid4"
        },
        "provider_request_id": {
          "$ref": "_defs.schema.json#/$defs/uuid4"
        },
        "refund_request_id": {
          "$ref": "_defs.schema.json#/$defs/nonempty_trimmed"
        },
        "registered_event_id": {
          "$ref": "_defs.schema.json#/$defs/uuid4"
        },
        "invocation": {
          "$ref": "#/$defs/invocation"
        },
        "dispatch_state": {
          "enum": ["NOT_DISPATCHED", "DISPATCHED", "UNKNOWN"]
        },
        "outcome": {
          "enum": ["SUCCEEDED", "REJECTED", "TIMED_OUT", "FAILED"]
        },
        "outcome_class": {
          "enum": ["PRE_DISPATCH_FAILURE", "REJECTION", "SUCCESS", "AMBIGUOUS"]
        },
        "provider_call_id": {
          "$ref": "_defs.schema.json#/$defs/uuid4"
        },
        "provider_transaction_id": {
          "$ref": "_defs.schema.json#/$defs/uuid4"
        },
        "late_transport_settlement": {
          "$ref": "#/$defs/late_settlement"
        },
        "knowledge_after_derived": {
          "enum": [
            "NOT_ATTEMPTED",
            "NO_EFFECT_CONFIRMED",
            "ONE_EFFECT_CONFIRMED",
            "MULTIPLE_EFFECTS_CONFIRMED",
            "UNKNOWN"
          ]
        },
        "knowledge_after_recorded": {
          "enum": [
            "NOT_ATTEMPTED",
            "NO_EFFECT_CONFIRMED",
            "ONE_EFFECT_CONFIRMED",
            "MULTIPLE_EFFECTS_CONFIRMED",
            "UNKNOWN"
          ]
        }
      },
      "required": [
        "attempt_id",
        "provider_request_id",
        "refund_request_id",
        "registered_event_id",
        "invocation",
        "dispatch_state",
        "outcome_class",
        "knowledge_after_derived"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "enum": ["SUCCEEDED", "REJECTED", "TIMED_OUT"]
              }
            },
            "required": ["outcome"]
          },
          "then": {
            "properties": {
              "dispatch_state": {
                "const": "DISPATCHED"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "SUCCEEDED"
              }
            },
            "required": ["outcome"]
          },
          "then": {
            "properties": {
              "outcome_class": {
                "const": "SUCCESS"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "REJECTED"
              }
            },
            "required": ["outcome"]
          },
          "then": {
            "properties": {
              "outcome_class": {
                "const": "REJECTION"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "TIMED_OUT"
              }
            },
            "required": ["outcome"]
          },
          "then": {
            "properties": {
              "outcome_class": {
                "const": "AMBIGUOUS"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "FAILED"
              },
              "dispatch_state": {
                "const": "NOT_DISPATCHED"
              }
            },
            "required": ["outcome", "dispatch_state"]
          },
          "then": {
            "properties": {
              "outcome_class": {
                "const": "PRE_DISPATCH_FAILURE"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "FAILED"
              },
              "dispatch_state": {
                "enum": ["DISPATCHED", "UNKNOWN"]
              }
            },
            "required": ["outcome", "dispatch_state"]
          },
          "then": {
            "properties": {
              "outcome_class": {
                "const": "AMBIGUOUS"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "dispatch_state": {
                "const": "DISPATCHED"
              }
            },
            "required": ["dispatch_state"],
            "not": {
              "required": ["outcome"]
            }
          },
          "then": {
            "properties": {
              "outcome_class": {
                "const": "AMBIGUOUS"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome_class": {
                "const": "PRE_DISPATCH_FAILURE"
              }
            },
            "required": ["outcome_class"]
          },
          "then": {
            "properties": {
              "dispatch_state": {
                "const": "NOT_DISPATCHED"
              }
            }
          }
        }
      ]
    },
    "provider_call": {
      "type": "object",
      "properties": {
        "provider_call_id": {
          "$ref": "_defs.schema.json#/$defs/uuid4"
        },
        "received_event_id": {
          "$ref": "_defs.schema.json#/$defs/uuid4"
        },
        "disposition": {
          "enum": ["ACCEPTED", "REJECTED", "UNRESOLVED"]
        },
        "attempt_id": {
          "$ref": "_defs.schema.json#/$defs/uuid4"
        },
        "provider_request_id": {
          "$ref": "_defs.schema.json#/$defs/uuid4"
        },
        "rejection_reason": {
          "enum": [
            "AUTHORIZATION_FAILED",
            "SCHEMA_INVALID",
            "EXECUTION_IDENTITY_MISMATCH",
            "IDENTITY_STRUCTURE_INVALID",
            "PAYMENT_NOT_FOUND",
            "AMOUNT_INVALID",
            "CURRENCY_MISMATCH"
          ]
        }
      },
      "required": ["provider_call_id", "received_event_id", "disposition"],
      "allOf": [
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "ACCEPTED"
              }
            },
            "required": ["disposition"]
          },
          "then": {
            "properties": {
              "attempt_id": true,
              "provider_request_id": true,
              "rejection_reason": false
            },
            "required": ["attempt_id", "provider_request_id"]
          }
        },
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "REJECTED"
              }
            },
            "required": ["disposition"]
          },
          "then": {
            "properties": {
              "rejection_reason": true,
              "attempt_id": false,
              "provider_request_id": false
            },
            "required": ["rejection_reason"]
          }
        },
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "UNRESOLVED"
              }
            },
            "required": ["disposition"]
          },
          "then": {
            "properties": {
              "attempt_id": false,
              "provider_request_id": false,
              "rejection_reason": false
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "transaction": {
      "type": "object",
      "properties": {
        "provider_transaction_id": {
          "$ref": "_defs.schema.json#/$defs/uuid4"
        },
        "provider_commit_id": {
          "$ref": "_defs.schema.json#/$defs/uuid4"
        },
        "provider_call_id": {
          "$ref": "_defs.schema.json#/$defs/uuid4"
        },
        "ledger_ref": {
          "$ref": "_defs.schema.json#/$defs/evidence_ref"
        }
      },
      "required": ["provider_transaction_id", "provider_commit_id", "provider_call_id", "ledger_ref"],
      "additionalProperties": false
    },
    "durable_execution": {
      "type": "object",
      "properties": {
        "durable_execution_arn": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["RUNNING", "SUCCEEDED", "FAILED", "TIMED_OUT", "STOPPED"]
        }
      },
      "required": ["durable_execution_arn", "status"],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "$ref": "_defs.schema.json#/$defs/execution_identity"
    },
    {
      "if": {
        "properties": {
          "transport_probe_id": true
        },
        "required": ["transport_probe_id"]
      },
      "then": {
        "properties": {
          "trial_id": false,
          "trial_manifest_sha256": false
        }
      }
    }
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_type": {
      "const": "attempt_projection"
    },
    "run_id": {
      "$ref": "_defs.schema.json#/$defs/uuid4"
    },
    "variant_validation_id": {
      "$ref": "_defs.schema.json#/$defs/uuid4"
    },
    "transport_probe_id": {
      "$ref": "_defs.schema.json#/$defs/uuid4"
    },
    "execution_manifest_sha256": {
      "$ref": "_defs.schema.json#/$defs/sha256"
    },
    "trial_id": {
      "$ref": "_defs.schema.json#/$defs/uuid4"
    },
    "trial_manifest_sha256": {
      "$ref": "_defs.schema.json#/$defs/sha256"
    },
    "attempts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/attempt"
      }
    },
    "provider_calls": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/provider_call"
      }
    },
    "transactions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/transaction"
      }
    },
    "durable_executions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/durable_execution"
      }
    },
    "derived_at": {
      "$ref": "_defs.schema.json#/$defs/utc_millis"
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "execution_manifest_sha256",
    "attempts",
    "provider_calls",
    "transactions",
    "durable_executions",
    "derived_at"
  ],
  "dependentRequired": {
    "trial_id": ["trial_manifest_sha256"],
    "trial_manifest_sha256": ["trial_id"]
  },
  "unevaluatedProperties": false
}
