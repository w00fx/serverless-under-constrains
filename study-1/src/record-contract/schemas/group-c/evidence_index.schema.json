{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rua.serverless-under-constraints.invalid/schemas/evidence_index.schema.json",
  "title": "evidence_index (catalogue group C, row 68)",
  "description": "trials/<t>/evidence-index.json or probe/evidence-index.json, the last file of a trial or of the probe: one entry per hashed file, sorted by artifact_path with unique paths, including the execution-level core files the trial depends on (BR-RUA-043, BR-RUA-044, AC-RUA-010). An evidence index never lists itself, another evidence index or the late-evidence area. A trial index names its run or variant validation and trial; the probe index names the probe and no trial (D-06).",
  "type": "object",
  "$defs": {
    "index_entry": {
      "type": "object",
      "properties": {
        "artifact_path": {
          "allOf": [
            {
              "$ref": "_defs.schema.json#/$defs/package_relative_path"
            },
            {
              "not": {
                "type": "string",
                "pattern": "(^|/)evidence-index\\.json$"
              }
            },
            {
              "not": {
                "type": "string",
                "pattern": "^late-evidence/"
              }
            }
          ]
        },
        "artifact_class": {
          "enum": [
            "environment_input",
            "execution_manifest",
            "preflight_journal",
            "source_provenance",
            "oracle_revision_check",
            "transport_scope_snapshot",
            "schema_file",
            "deployment_assembly_file",
            "deployment_assembly_inventory",
            "coordination_journal",
            "coordination_prefix_checkpoint",
            "provisioning_journal",
            "resource_manifest",
            "runner_journal",
            "provider_warmup_journal",
            "controller_canary_journal",
            "trial_manifest",
            "payment",
            "approved_decision",
            "published_message",
            "provider_trial_configuration",
            "treatment_state_snapshot",
            "trial_registration",
            "caller_journal",
            "provider_journal",
            "controller_journal",
            "ledger_snapshot",
            "source_observations",
            "dlq_observations",
            "dlq_snapshot",
            "settlement_samples",
            "durable_execution_metadata",
            "telemetry_availability",
            "attempt_projection",
            "oracle_result",
            "transport_probe_result",
            "evidence_index",
            "late_evidence_stream",
            "late_evidence_assessment",
            "pre_cleanup_snapshot",
            "cleanup_journal",
            "cleanup_result",
            "leak_audit_result",
            "comparison_assessment",
            "safety_assessment",
            "run_summary",
            "validation_summary",
            "transport_probe_summary",
            "operational_recovery_record",
            "billing_import",
            "billing_export_file"
          ]
        },
        "derivation": {
          "enum": ["primary", "derived"]
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sha256": {
          "$ref": "_defs.schema.json#/$defs/sha256"
        }
      },
      "required": ["artifact_path", "artifact_class", "derivation", "bytes", "sha256"],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "index_scope": {
            "const": "TRIAL"
          }
        },
        "required": ["index_scope"]
      },
      "then": {
        "properties": {
          "trial_id": true,
          "trial_manifest_sha256": true,
          "transport_probe_id": false
        },
        "required": ["trial_id", "trial_manifest_sha256"],
        "oneOf": [
          {
            "properties": {
              "run_id": true
            },
            "required": ["run_id"]
          },
          {
            "properties": {
              "variant_validation_id": true
            },
            "required": ["variant_validation_id"]
          }
        ]
      },
      "else": {
        "properties": {
          "transport_probe_id": true,
          "run_id": false,
          "variant_validation_id": false,
          "trial_id": false,
          "trial_manifest_sha256": false
        },
        "required": ["transport_probe_id"]
      }
    }
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_type": {
      "const": "evidence_index"
    },
    "run_id": {
      "$ref": "_defs.schema.json#/$defs/uuid4"
    },
    "variant_validation_id": {
      "$ref": "_defs.schema.json#/$defs/uuid4"
    },
    "transport_probe_id": {
      "$ref": "_defs.schema.json#/$defs/uuid4"
    },
    "execution_manifest_sha256": {
      "$ref": "_defs.schema.json#/$defs/sha256"
    },
    "trial_id": {
      "$ref": "_defs.schema.json#/$defs/uuid4"
    },
    "trial_manifest_sha256": {
      "$ref": "_defs.schema.json#/$defs/sha256"
    },
    "index_scope": {
      "enum": ["TRIAL", "PROBE"]
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/index_entry"
      },
      "minItems": 1,
      "x-rua-evidence-ref-order": true
    },
    "created_at": {
      "$ref": "_defs.schema.json#/$defs/utc_millis"
    }
  },
  "required": ["schema_version", "record_type", "execution_manifest_sha256", "index_scope", "entries", "created_at"],
  "additionalProperties": false
}
