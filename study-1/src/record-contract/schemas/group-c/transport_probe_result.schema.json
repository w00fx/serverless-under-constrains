{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rua.serverless-under-constraints.invalid/schemas/transport_probe_result.schema.json",
  "title": "transport_probe_result (catalogue group C, row 69)",
  "description": "probe/derived/transport-probe-result.json, frozen before cleanup (CTR-RUA-003, BR-RUA-027). Ordering is cross-source wall clock under the declared clock assumption; the schema has no property that could claim formal happened-before proof (AC-RUA-002). Precedence: an invalid probe is indeterminate; a pass needs a probe that is not invalid (valid or indeterminate), verified evidence and six passing conditions, exactly as BR-RUA-027 states; BR-RUA-026 usability, not this record, requires a valid probe. A pass or fail condition cites at least one evidence reference (BR-RUA-035).",
  "type": "object",
  "$defs": {
    "condition_result": {
      "type": "object",
      "properties": {
        "condition_id": {
          "enum": ["BR-RUA-010", "BR-RUA-011", "BR-RUA-012", "BR-RUA-013", "BR-RUA-014", "BR-RUA-015"]
        },
        "result": {
          "enum": ["pass", "fail", "indeterminate"]
        },
        "expected": {
          "not": {
            "type": "null"
          }
        },
        "observed": {
          "not": {
            "type": "null"
          }
        },
        "evidence_refs": {
          "$ref": "_defs.schema.json#/$defs/evidence_refs"
        },
        "indeterminate_reasons": {
          "$ref": "_defs.schema.json#/$defs/structured_reasons"
        },
        "affected_by": {
          "type": "array",
          "items": {
            "enum": [
              "EQUIVALENT_DUPLICATE_COLLAPSED",
              "CONFLICTING_EVENT_CONTENT",
              "CONFLICTING_SOURCE_SEQUENCE",
              "SOURCE_SEQUENCE_GAP",
              "CAUSAL_PREDECESSOR_MISSING",
              "DUPLICATE_LEDGER_TRANSACTION_ID",
              "LEDGER_PAGINATION_INCOMPLETE",
              "CORE_FILE_DIGEST_MISMATCH",
              "ARTIFACT_MISSING",
              "ARTIFACT_UNPARSEABLE",
              "RECORD_SCHEMA_INVALID",
              "CORRELATION_MISSING",
              "LEDGER_LARGER_THAN_EXPECTED"
            ]
          },
          "uniqueItems": true
        }
      },
      "required": [
        "condition_id",
        "result",
        "expected",
        "observed",
        "evidence_refs",
        "indeterminate_reasons",
        "affected_by"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "result": {
                "enum": ["pass", "fail"]
              }
            },
            "required": ["result"]
          },
          "then": {
            "properties": {
              "evidence_refs": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "probe_cardinality": {
      "type": "object",
      "properties": {
        "caller_invocations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "accepted_provider_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "committed_transactions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["caller_invocations", "accepted_provider_calls", "committed_transactions"],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "fidelity_basis": {
            "const": "causal_plus_cross_source_clock_assumption"
          }
        },
        "required": ["fidelity_basis"]
      },
      "then": {
        "properties": {
          "clock_assumption_refs": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "probe_validity": {
            "const": "invalid"
          }
        },
        "required": ["probe_validity"]
      },
      "then": {
        "properties": {
          "transport_probe_verdict": {
            "const": "indeterminate"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "transport_probe_verdict": {
            "const": "pass"
          }
        },
        "required": ["transport_probe_verdict"]
      },
      "then": {
        "properties": {
          "probe_validity": {
            "enum": ["valid", "indeterminate"]
          },
          "evidence_integrity": {
            "const": "verified"
          },
          "condition_results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "result": {
                  "const": "pass"
                }
              }
            }
          }
        }
      }
    }
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_type": {
      "const": "transport_probe_result"
    },
    "transport_probe_id": {
      "$ref": "_defs.schema.json#/$defs/uuid4"
    },
    "run_id": false,
    "variant_validation_id": false,
    "trial_id": false,
    "trial_manifest_sha256": false,
    "execution_manifest_sha256": {
      "$ref": "_defs.schema.json#/$defs/sha256"
    },
    "transport_probe_verdict": {
      "enum": ["pass", "fail", "indeterminate"]
    },
    "probe_validity": {
      "enum": ["valid", "invalid", "indeterminate"]
    },
    "probe_cardinality": {
      "$ref": "#/$defs/probe_cardinality"
    },
    "evidence_integrity": {
      "enum": ["verified", "invalid", "unverified"]
    },
    "treatment_fidelity": {
      "enum": ["verified", "invalid", "unverified"]
    },
    "fidelity_basis": {
      "enum": ["causal_plus_cross_source_clock_assumption", "causal"]
    },
    "clock_assumption_refs": {
      "type": "array",
      "items": {
        "enum": ["CA-1"]
      },
      "uniqueItems": true
    },
    "ordering_basis": {
      "enum": ["cross_source_wall_clock"]
    },
    "condition_results": {
      "type": "array",
      "prefixItems": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/condition_result"
            },
            {
              "type": "object",
              "properties": {
                "condition_id": {
                  "const": "BR-RUA-010"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/condition_result"
            },
            {
              "type": "object",
              "properties": {
                "condition_id": {
                  "const": "BR-RUA-011"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/condition_result"
            },
            {
              "type": "object",
              "properties": {
                "condition_id": {
                  "const": "BR-RUA-012"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/condition_result"
            },
            {
              "type": "object",
              "properties": {
                "condition_id": {
                  "const": "BR-RUA-013"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/condition_result"
            },
            {
              "type": "object",
              "properties": {
                "condition_id": {
                  "const": "BR-RUA-014"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/condition_result"
            },
            {
              "type": "object",
              "properties": {
                "condition_id": {
                  "const": "BR-RUA-015"
                }
              }
            }
          ]
        }
      ],
      "minItems": 6,
      "maxItems": 6,
      "items": false
    },
    "evidence_refs": {
      "$ref": "_defs.schema.json#/$defs/evidence_refs"
    },
    "indeterminate_reasons": {
      "$ref": "_defs.schema.json#/$defs/structured_reasons"
    },
    "checked_at": {
      "$ref": "_defs.schema.json#/$defs/utc_millis"
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "transport_probe_id",
    "execution_manifest_sha256",
    "transport_probe_verdict",
    "probe_validity",
    "probe_cardinality",
    "evidence_integrity",
    "treatment_fidelity",
    "fidelity_basis",
    "clock_assumption_refs",
    "ordering_basis",
    "condition_results",
    "evidence_refs",
    "indeterminate_reasons",
    "checked_at"
  ],
  "unevaluatedProperties": false
}
