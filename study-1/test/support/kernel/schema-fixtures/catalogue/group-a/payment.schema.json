{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rua.serverless-under-constraints.invalid/schemas/payment.schema.json",
  "$comment": "Kernel test fixture exercising the shared $defs; not the WP-01 catalogue schema.",
  "type": "object",
  "properties": {
    "schema_version": { "const": 1 },
    "record_type": { "const": "payment" },
    "payment_id": { "$ref": "_defs.schema.json#/$defs/uuid4" },
    "captured_amount_minor": { "$ref": "_defs.schema.json#/$defs/amount_minor" },
    "refunded_total_minor": { "$ref": "_defs.schema.json#/$defs/decimal_aggregate" },
    "captured_at": { "$ref": "_defs.schema.json#/$defs/utc_millis" },
    "currency": { "const": "BRL" },
    "note": { "$ref": "_defs.schema.json#/$defs/nonempty_trimmed" }
  },
  "required": [
    "schema_version",
    "record_type",
    "payment_id",
    "captured_amount_minor",
    "refunded_total_minor",
    "captured_at",
    "currency"
  ],
  "additionalProperties": false
}
