{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "tap",
  "tap": {
    "testFiles": ["test/unit/**/*.test.ts", "test/golden/**/*.golden.test.ts", "test/contract/**/*.contract.test.ts"],
    "nodeArgs": ["--test-reporter=tap", "-r", "{{hookFile}}", "{{testFile}}"],
    "forceBail": true
  },
  "checkers": ["typescript"],
  "tsconfigFile": "tsconfig.mutation.json",
  "typescriptChecker": { "prioritizePerformanceOverAccuracy": false },
  "mutate": [
    "src/**/*.ts",
    "tools/lib/**/*.ts",
    "!src/**/aws/**",
    "!src/**/node/**",
    "!src/**/*.handler.ts",
    "!src/operator-cli/main.ts",
    "!src/operator-cli/composition-root.ts",
    "!infra/**"
  ],
  "coverageAnalysis": "perTest",
  "reporters": ["clear-text", "progress", "json"],
  "jsonReporter": { "fileName": "reports/mutation/mutation.json" },
  "thresholds": { "high": 100, "low": 100, "break": 100 },
  "ignoreStatic": false,
  "concurrency": 4,
  "incrementalFile": "reports/stryker-incremental.json",
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": "always"
}
